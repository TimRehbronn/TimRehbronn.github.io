---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('blog', (p) => import.meta.env.DEV || !p.data.draft)).sort(
  (a, b) => +b.data.date - +a.data.date,
);
const years = [...new Set(posts.map((p) => p.data.date.getFullYear()))];
const fmt = new Intl.DateTimeFormat('en', { month: 'short', day: 'numeric' });

// Planned topics, from foundations to full systems.
const roadmap = [
  { title: 'Probability theory', text: 'random variables, Bayes’ rule, Gaussians and uncertainty' },
  { title: 'State estimation', text: 'Bayes filters, Kalman filters, EKF, error-state and iterated EKF' },
  { title: 'Factor graphs', text: 'estimation as optimization, smoothing and sensor fusion' },
  { title: 'Multi-object detection', text: 'from point clouds and images to object hypotheses' },
  { title: 'Multi-object tracking', text: 'data association, JPDA and random finite sets (PMBM)' },
  { title: 'SLAM', text: 'localizing while mapping the environment' },
];
---

<Base title="Blog" description="Interactive explanations and notes.">
  <header class="page-header">
    <p class="kicker">Learning blog</p>
    <h1>Blog</h1>
    <p>A learning blog on estimation and perception for autonomous systems — explained step by step, with interactive figures. <a href="/rss.xml">RSS</a></p>
  </header>

  <section class="section">
    <h2 class="section-title">Roadmap</h2>
    <ol class="roadmap">
      {roadmap.map((r, i) => (
        <li class="panel">
          <span class="label idx">{String(i + 1).padStart(2, '0')}</span>
          <h3>{r.title}</h3>
          <p>{r.text}</p>
        </li>
      ))}
    </ol>
  </section>

  {posts.length === 0 && <p class="empty">The first posts are on their way.</p>}

  {
    years.map((year) => (
      <section class="section">
        <h2 class="section-title">{year}</h2>
        <ul class="posts">
          {posts
            .filter((p) => p.data.date.getFullYear() === year)
            .map((p) => (
              <li>
                <time class="label" datetime={p.data.date.toISOString()}>{fmt.format(p.data.date)}</time>
                <div>
                  <a href={`/blog/${p.id}/`}>{p.data.title}</a>
                  {p.data.draft && <span class="tag">draft</span>}
                  <p class="muted small">{p.data.description}</p>
                </div>
              </li>
            ))}
        </ul>
      </section>
    ))
  }
</Base>

<style>
  .roadmap { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(17rem, 100%), 1fr)); gap: 0.75rem; }
  .roadmap li { padding: 1.1rem 1.2rem; }
  .roadmap .idx { color: var(--accent); }
  .roadmap h3 { margin: 0.4rem 0 0.3rem; font-size: 1rem; }
  .roadmap p { margin: 0; font-size: 0.9rem; }
  .posts { list-style: none; padding: 0; margin: 0; display: grid; gap: 1.1rem; }
  .posts li { display: grid; grid-template-columns: 4.5rem 1fr; gap: 1rem; }
  .posts li a { font-weight: 550; font-size: 1.05rem; }
  .posts li p { margin: 0.15rem 0 0; }
  time { padding-top: 0.2rem; font-variant-numeric: tabular-nums; }
  .tag { margin-left: 0.5rem; }
</style>
