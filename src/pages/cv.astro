---
import Base from '../layouts/Base.astro';
import { SITE } from '../config';
import { emph } from '../lib/format';
import { education, experience, service, awards, schools, skills, type CvEntry } from '../data/cv';

const sections: { title: string; items: CvEntry[] }[] = [
  { title: 'Experience', items: experience },
  { title: 'Education', items: education },
  { title: 'Service, Teaching & Supervision', items: service },
];
const lists = [
  { title: 'Awards', items: awards },
  { title: 'Schools & Trainings', items: schools },
];
---

<Base title="CV" description={`Curriculum vitae of ${SITE.name}.`}>
  <header class="page-header head">
    <div>
      <p class="kicker">Résumé</p>
      <h1>Curriculum Vitae</h1>
      <p>{SITE.role} · {SITE.affiliation} · {SITE.location}</p>
    </div>
    <div class="actions no-print">
      {SITE.cvPdf && <a class="btn btn-primary" href={SITE.cvPdf}>Download PDF</a>}
      <button class="btn" type="button" onclick="window.print()">Print / Save as PDF</button>
    </div>
  </header>

  {
    sections
      .filter((s) => s.items.length > 0)
      .map((s) => (
        <section class="section">
          <h2 class="section-title">{s.title}</h2>
          <ol class="entries">
            {s.items.map((e) => (
              <li>
                <span class="when label">
                  {e.start}
                  {e.end !== e.start && <> – {e.end ?? 'present'}</>}
                </span>
                <div>
                  <h3>{e.title}</h3>
                  <p class="org">
                    {e.orgUrl ? <a href={e.orgUrl}>{e.org}</a> : e.org}
                    {e.location && <span class="muted">, {e.location}</span>}
                  </p>
                  {e.details && <ul>{e.details.map((d) => <li set:html={emph(d)} />)}</ul>}
                </div>
              </li>
            ))}
          </ol>
        </section>
      ))
  }

  {
    lists
      .filter((l) => l.items.length > 0)
      .map((l) => (
        <section class="section">
          <h2 class="section-title">{l.title}</h2>
          <ol class="entries">
            {l.items.map((a) => (
              <li>
                <span class="when label">{a.year}</span>
                <div>
                  <h3>{a.url ? <a href={a.url} set:html={emph(a.title)} /> : <span set:html={emph(a.title)} />}</h3>
                  {a.detail && <p class="org" set:html={emph(a.detail)} />}
                </div>
              </li>
            ))}
          </ol>
        </section>
      ))
  }

  <section class="section">
    <h2 class="section-title">Skills</h2>
    <dl class="skills">
      {skills.map((s) => <><dt class="label">{s.group}</dt><dd>{s.items.join(' · ')}</dd></>)}
    </dl>
  </section>

  <p class="small muted">Publications are listed on the <a href="/publications/">publications page</a>.</p>
</Base>

<style>
  .head { display: flex; justify-content: space-between; align-items: end; gap: 1.5rem; flex-wrap: wrap; }
  .actions { display: flex; gap: 0.5rem; }
  .entries { list-style: none; padding: 0; margin: 0; }
  .entries > li { display: grid; grid-template-columns: 9rem 1fr; gap: 1.25rem; padding: 1.25rem 0; border-top: 1px solid var(--border); }
  .entries > li:first-child, .skills dt:first-of-type, .skills dt:first-of-type + dd { border-top: 0; padding-top: 0; }
  .when { padding-top: 0.2rem; }
  h3 { margin: 0 0 0.2rem; font-size: 1rem; }
  h3 a { text-decoration: none; }
  .org { margin: 0; color: var(--fg-soft); font-size: 0.92rem; }
  .org a { color: var(--fg-soft); }
  .entries ul { margin: 0.6rem 0 0; padding-left: 1rem; font-size: 0.92rem; }
  .entries ul li { margin: 0.25rem 0; }
  .entries ul li::marker { content: '— '; color: var(--border-strong); }
  .skills { display: grid; grid-template-columns: 9rem 1fr; gap: 0; margin: 0; }
  dt, dd { padding: 0.75rem 0; border-top: 1px solid var(--border); }
  dt { padding-top: 0.95rem; }
  dd { margin: 0; color: var(--fg); font-size: 0.95rem; }
  @media (max-width: 560px) {
    .entries > li, .skills { grid-template-columns: 1fr; gap: 0.15rem; }
  }
</style>
