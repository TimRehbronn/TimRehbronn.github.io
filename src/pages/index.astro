---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Publication from '../components/Publication.astro';
import ProjectCard from '../components/ProjectCard.astro';
import NewsList from '../components/NewsList.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { SITE, SOCIALS } from '../config';
import { interests, current } from '../data/cv';

const selected = (await getCollection('publications', (p) => p.data.selected)).sort((a, b) => b.data.year - a.data.year);
const featured = (await getCollection('projects', (p) => p.data.featured)).sort((a, b) => b.data.year - a.data.year).slice(0, 4);
const posts = (await getCollection('blog', (p) => !p.data.draft)).sort((a, b) => +b.data.date - +a.data.date).slice(0, 3);
const fmt = new Intl.DateTimeFormat('en', { month: 'short', day: 'numeric', year: 'numeric' });

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.name,
  jobTitle: SITE.role,
  affiliation: SITE.affiliation,
  url: Astro.site?.toString(),
  identifier: 'https://orcid.org/0009-0009-5241-2588',
  sameAs: SOCIALS.filter((s) => s.href.startsWith('http')).map((s) => s.href),
};
---

<Base>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <section class="hero">
    <div class="intro">
      <h1>{SITE.name}</h1>
      <p class="lead"><span class="accent">State estimation and sensor fusion</span> for autonomous systems.</p>
      <p>I'm a researcher and PhD candidate in the <a href="https://www.irt.rwth-aachen.de">Navigation Group of the Institute of Automatic Control (IRT)</a> at RWTH Aachen University, supervised by Prof. Heike Vallery.</p>
      <p>My projects have covered sensor calibration, GNSS/IMU navigation, LiDAR/radar/camera odometry, LiDAR 3D object detection, multi-object tracking and trajectory prediction. This gives me an overview of the methods as well as detailed knowledge of them. I have experience building the architecture and the components and deploying them on real platforms.</p>
      <p>I lead the “Water” expert group of the innocam.NRW competence network and have supervised several Bachelor’s and Master’s theses in my research area. Through <strong>extensive training in project management and leadership</strong>, I have learned to work in a structured and goal-oriented way.</p>
      <p>Before starting my doctorate, I studied Electrical Engineering, Information Technology and Computer Engineering at RWTH (M.Sc. <strong>with distinction</strong>, Dean’s List) and worked on automated driving at Bosch and the Institute for Automotive Engineering (ika).</p>
      <SocialLinks />
    </div>
    <figure class="portrait">
      <img src={SITE.avatar} alt={`Portrait of ${SITE.name}`} width="220" height="220" />
    </figure>
  </section>

  <section class="section">
    <h2 class="section-title">Currently working on</h2>
    <ol class="current">
      {
        current.map((c, i) => (
          <li class="panel">
            <span class="idx label">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3>{c.href ? <a href={c.href}>{c.title}</a> : c.title}</h3>
              <p>{c.text}</p>
              <ul class="tags">{c.tags.map((t) => <li class="tag">{t}</li>)}</ul>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section">
    <h2 class="section-title">Research interests</h2>
    <ul class="interests">
      {interests.map((i) => <li class="panel"><h3>{i.title}</h3><p>{i.text}</p></li>)}
    </ul>
  </section>

  <section class="section">
    <h2 class="section-title">News</h2>
    <NewsList />
  </section>

  {
    selected.length > 0 && (
      <section class="section">
        <h2 class="section-title">Selected publications <a href="/publications/">All →</a></h2>
        {selected.map((pub) => <Publication pub={pub} />)}
      </section>
    )
  }

  {
    featured.length > 0 && (
      <section class="section">
        <h2 class="section-title">Featured projects <a href="/projects/">All →</a></h2>
        <div class="grid">{featured.map((p) => <ProjectCard project={p} />)}</div>
      </section>
    )
  }

  {
    posts.length > 0 && (
      <section class="section">
        <h2 class="section-title">Writing <a href="/blog/">All →</a></h2>
        <ul class="posts">
          {posts.map((p) => (
            <li>
              <a href={`/blog/${p.id}/`}>{p.data.title}</a>
              <time class="label" datetime={p.data.date.toISOString()}>{fmt.format(p.data.date)}</time>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>

<style>
  .hero { position: relative; display: grid; grid-template-columns: 1fr auto; gap: 3rem; align-items: start; padding: 5rem 0 1rem; }
  .hero::before {
    content: ''; position: absolute; z-index: -1; pointer-events: none; inset: 0 -50vw -4rem;
    background-image:
      linear-gradient(to right, rgba(255, 255, 255, 0.045) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.045) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(ellipse 55% 75% at 50% 25%, #000 25%, transparent 75%);
  }
  h1 { margin: 0 0 0.75rem; }
  .lead .accent { color: var(--accent); }
  .lead { font-size: 1.2rem; color: var(--fg); letter-spacing: -0.01em; margin-bottom: 1.75rem; max-width: 34rem; }
  .intro > p:not(.kicker):not(.lead) { max-width: var(--w-text); }
  .intro :global(.socials) { margin-top: 1.75rem; }

  .portrait { margin: 0.5rem 0 0; position: relative; padding: 8px; border: 1px solid var(--border-strong); }
  .portrait img { width: 13rem; height: 13rem; object-fit: cover; }
  .portrait::before, .portrait::after { content: ''; position: absolute; width: 12px; height: 12px; border: 2px solid var(--accent); }
  .portrait::before { top: -2px; left: -2px; border-right: 0; border-bottom: 0; }
  .portrait::after { bottom: -2px; right: -2px; border-left: 0; border-top: 0; }

  .current { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.75rem; }
  .current > li { display: grid; grid-template-columns: 2.5rem 1fr; gap: 0.5rem; padding: 1.25rem 1.25rem 1.25rem 1rem; }
  .current .idx { color: var(--accent); padding-top: 0.2rem; }
  .current h3 { margin: 0 0 0.35rem; }
  .current h3 a { text-decoration: none; }
  .current p { margin: 0 0 0.75rem; }

  .interests { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(22rem, 100%), 1fr)); gap: 0.75rem; }
  .interests li { padding: 1.25rem; }
  .interests h3 { margin: 0 0 0.5rem; }
  .interests p { margin: 0; font-size: 0.95rem; }

  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(17rem, 100%), 1fr)); gap: 0.75rem; }
  .posts { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.75rem; }
  .posts li { display: flex; justify-content: space-between; gap: 1rem; align-items: baseline; flex-wrap: wrap; }

  @media (max-width: 760px) {
    .hero { grid-template-columns: 1fr; gap: 2rem; padding-top: 2.5rem; }
    .portrait { order: -1; width: fit-content; }
    .portrait img { width: 8rem; height: 8rem; }
  }
</style>
