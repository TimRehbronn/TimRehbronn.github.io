---
import { NAV, SITE } from '../config';
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href="/" aria-label={`${SITE.name} — home`}>
      <span class="mark" aria-hidden="true"></span>{SITE.name}
    </a>
    <nav aria-label="Main">
      <ul>
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 5;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: saturate(160%) blur(12px);
    border-bottom: 1px solid var(--border);
  }
  .bar { display: flex; align-items: center; gap: 1.5rem; min-height: 3.5rem; }
  .brand {
    display: inline-flex; align-items: center; gap: 0.6rem; margin-right: auto;
    font-family: var(--font-mono); font-size: 0.8rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.14em;
    color: var(--fg); text-decoration: none;
  }
  .brand:hover { color: var(--fg); }
  .mark { width: 9px; height: 9px; background: var(--accent); }
  nav ul { display: flex; gap: 0.25rem 1.4rem; list-style: none; margin: 0; padding: 0; }
  nav a {
    position: relative; display: inline-block; padding: 1.1rem 0;
    font-family: var(--font-mono); font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.12em;
    color: var(--muted); text-decoration: none;
  }
  nav a:hover { color: var(--fg); }
  nav a[aria-current='page'] { color: var(--fg); }
  nav a[aria-current='page']::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; background: var(--accent);
  }

  @media (max-width: 720px) {
    .bar { flex-wrap: wrap; gap: 0; padding-top: 0.75rem; }
    nav { width: 100%; overflow-x: auto; scrollbar-width: none; }
    nav a { padding: 0.75rem 0; }
  }
</style>
