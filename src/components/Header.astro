---
import { NAV, SITE } from '../config';
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href="/">{SITE.name}</a>
    <nav aria-label="Main">
      <ul>
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <button class="theme-toggle" type="button" aria-label="Toggle dark mode" title="Toggle dark mode">
      <svg class="sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="4.5" fill="currentColor"/><g stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 1.5v2.5M12 20v2.5M1.5 12H4M20 12h2.5M4.6 4.6l1.8 1.8M17.6 17.6l1.8 1.8M4.6 19.4l1.8-1.8M17.6 6.4l1.8-1.8"/></g></svg>
      <svg class="moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M20.5 14.6A8.5 8.5 0 0 1 9.4 3.5a8.5 8.5 0 1 0 11.1 11.1z"/></svg>
    </button>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.theme-toggle');
  btn?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch {}
  });
</script>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 5;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: saturate(180%) blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .bar { display: flex; align-items: center; gap: 1rem; min-height: 3.5rem; flex-wrap: wrap; }
  .brand { font-weight: 650; color: var(--fg); letter-spacing: -0.01em; margin-right: auto; }
  .brand:hover { text-decoration: none; }
  nav ul { display: flex; flex-wrap: wrap; gap: 0.15rem 1rem; list-style: none; margin: 0; padding: 0; font-size: 0.93rem; }
  nav a { color: var(--fg-soft); }
  nav a:hover { color: var(--fg); text-decoration: none; }
  nav a[aria-current='page'] { color: var(--fg); font-weight: 600; }
  .theme-toggle {
    display: grid; place-items: center; width: 2rem; height: 2rem; padding: 0;
    border: 1px solid var(--border); border-radius: 8px; background: transparent; color: var(--fg-soft); cursor: pointer;
  }
  .theme-toggle:hover { color: var(--fg); border-color: var(--fg-soft); }
  :global(:root[data-theme='dark']) .sun { display: none; }
  :global(:root:not([data-theme='dark'])) .moon { display: none; }

  @media (max-width: 640px) {
    .bar { padding-top: 0.6rem; padding-bottom: 0.6rem; }
    nav { order: 3; width: 100%; overflow-x: auto; }
    nav ul { flex-wrap: nowrap; white-space: nowrap; }
  }
</style>
