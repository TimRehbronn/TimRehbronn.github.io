---
import { getCollection } from 'astro:content';
interface Props { limit?: number }
const { limit = 6 } = Astro.props;
const news = (await getCollection('news')).sort((a, b) => +b.data.date - +a.data.date).slice(0, limit);
const fmt = new Intl.DateTimeFormat('en', { month: 'short', year: 'numeric' });
---

<ul class="news">
  {
    news.map((n) => (
      <li>
        <time datetime={n.data.date.toISOString()}>{fmt.format(n.data.date)}</time>
        <span>{n.data.link ? <a href={n.data.link}>{n.data.text}</a> : n.data.text}</span>
      </li>
    ))
  }
</ul>

<style>
  .news { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.5rem; }
  li { display: grid; grid-template-columns: 5.5rem 1fr; gap: 1rem; font-size: 0.97rem; }
  time { color: var(--muted); font-variant-numeric: tabular-nums; font-size: 0.9rem; padding-top: 0.05rem; }
</style>
