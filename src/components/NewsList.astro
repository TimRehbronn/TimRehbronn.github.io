---
import { getCollection } from 'astro:content';
interface Props { limit?: number }
const { limit = 6 } = Astro.props;
const news = (await getCollection('news')).sort((a, b) => +b.data.date - +a.data.date).slice(0, limit);
const fmt = new Intl.DateTimeFormat('en', { month: 'short', year: 'numeric' });
---

<ul class="news">
  {
    news.map((n) => (
      <li>
        <time class="label" datetime={n.data.date.toISOString()}>{fmt.format(n.data.date)}</time>
        <span>{n.data.link ? <a href={n.data.link}>{n.data.text}</a> : n.data.text}</span>
      </li>
    ))
  }
</ul>

<style>
  .news { list-style: none; padding: 0; margin: 0; }
  li { display: grid; grid-template-columns: 6.5rem 1fr; gap: 1rem; padding: 0.8rem 0; border-top: 1px solid var(--border); font-size: 0.95rem; }
  li:last-child { border-bottom: 1px solid var(--border); }
  time { padding-top: 0.2rem; }
  a { color: var(--fg-soft); text-decoration-color: var(--border-strong); }
  a:hover { color: var(--accent); }
  @media (max-width: 520px) { li { grid-template-columns: 1fr; gap: 0.2rem; } }
</style>
