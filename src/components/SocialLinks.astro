---
import Icon from './Icon.astro';
import { SOCIALS } from '../config';
interface Props { rss?: boolean; size?: number }
const { rss = false, size = 16 } = Astro.props;
const items = rss ? [...SOCIALS, { label: 'RSS', href: '/rss.xml', icon: 'rss' as const }] : SOCIALS;
---

<ul class="socials">
  {
    items.map((s) => (
      <li>
        <a href={s.href} rel={s.href.startsWith('http') ? 'me noopener' : undefined}>
          <Icon name={s.icon} size={size} />
          <span>{s.label}</span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .socials { display: flex; flex-wrap: wrap; gap: 0.4rem 1.1rem; padding: 0; margin: 0; list-style: none; font-size: 0.92rem; }
  a { display: inline-flex; align-items: center; gap: 0.4rem; font-weight: 500; color: var(--fg-soft); }
  a:hover { color: var(--accent); text-decoration: none; }
  a :global(.icon) { color: var(--accent); }
</style>
