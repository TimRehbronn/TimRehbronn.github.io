---
// Title figure: a closed box carried along a path, seen from above. Inside it one can feel pushes and turns,
// but not steady motion. Adding up the measured changes reproduces the path, but the errors add up as well.
---

<figure class="xp wide" data-xp="introbox">
  <div class="xp-head"><span class="label fig-title">Navigating from inside a closed box</span></div>
  <canvas role="img" aria-label="Top view of a path with a straight section and two turns. A box is shown at the start, on the straight section and in a turn. A second, dashed path computed from the measurements starts at the same point and slowly drifts away from the true path."></canvas>
  <ul class="xp-legend">
    <li class="c-fg"><i></i><span>true path of the box</span></li>
    <li class="c-accent dash"><i></i><span>path computed by adding up the measured changes</span></li>
  </ul>
  <figcaption><slot /></figcaption>
</figure>

<script>
  import { palette, setupCanvas, arrow, label, lazyInit } from '../../../lib/explainer';

  type P = { x: number; y: number; h: number };
  const N = 600;
  // curvature along the path: straight, left turn, straight, right turn, straight
  const kappa = (s: number) => (s > 0.26 && s < 0.46 ? 5 : s > 0.62 && s < 0.82 ? -5 : 0);
  function path(gyroErr: number, speedErr: number): P[] {
    const out: P[] = [{ x: 0, y: 0, h: 0 }];
    let x = 0, y = 0, h = 0;
    for (let i = 1; i <= N; i++) {
      const s = i / N, ds = 1 / N;
      h += (kappa(s) + gyroErr) * ds;
      const v = 1 + speedErr * s;
      x += v * Math.cos(h) * ds; y += v * Math.sin(h) * ds;
      out.push({ x, y, h });
    }
    return out;
  }

  lazyInit('[data-xp="introbox"]', (fig) => {
    const canvas = fig.querySelector('canvas')!;
    const truth = path(0, 0), est = path(0.16, 0.1);
    const { ctx, size } = setupCanvas(canvas, (w) => (w < 560 ? w * 0.72 : Math.max(300, w * 0.48)), draw);

    function draw() {
      const C = palette(), W = size.w, H = size.h;
      if (!W) return;
      ctx.clearRect(0, 0, W, H);
      const narrow = W < 560, fs = narrow ? 10.5 : 12;
      // fit both paths into the canvas, keeping room for the labels
      const all = truth.concat(est);
      const x0 = Math.min(...all.map((p) => p.x)), x1 = Math.max(...all.map((p) => p.x));
      const y0 = Math.min(...all.map((p) => p.y)), y1 = Math.max(...all.map((p) => p.y));
      const mx = narrow ? 16 : W * 0.06, mt = narrow ? 58 : 50, mb = narrow ? 50 : 56;
      const sc = Math.min((W - 2 * mx) / (x1 - x0), (H - mt - mb) / (y1 - y0));
      const ox = (W - sc * (x1 - x0)) / 2, oy = mt + (H - mt - mb - sc * (y1 - y0)) / 2;
      const X = (p: P) => ox + (p.x - x0) * sc, Y = (p: P) => oy + (y1 - p.y) * sc;   // north up

      const stroke = (pts: P[], col: string, w: number, dash: number[]) => {
        ctx.strokeStyle = col; ctx.lineWidth = w; ctx.setLineDash(dash); ctx.beginPath();
        pts.forEach((p, i) => (i ? ctx.lineTo(X(p), Y(p)) : ctx.moveTo(X(p), Y(p)))); ctx.stroke(); ctx.setLineDash([]);
      };
      stroke(truth, C.fg, 2, []);
      stroke(est, C.accent, 2, [7, 5]);

      const B = narrow ? 18 : 24;
      const box = (p: P, col: string, dashed = false) => {
        const cx = X(p), cy = Y(p);
        ctx.save(); ctx.translate(cx, cy); ctx.rotate(-p.h);
        ctx.fillStyle = C.bg; ctx.strokeStyle = col; ctx.lineWidth = 1.75; ctx.setLineDash(dashed ? [4, 3] : []);
        ctx.fillRect(-B / 2, -B / 2, B, B); ctx.strokeRect(-B / 2, -B / 2, B, B); ctx.setLineDash([]);
        // forward mark
        ctx.beginPath(); ctx.moveTo(B * 0.12, -B * 0.22); ctx.lineTo(B * 0.34, 0); ctx.lineTo(B * 0.12, B * 0.22); ctx.strokeStyle = col; ctx.lineWidth = 1.5; ctx.stroke();
        ctx.restore();
        return { cx, cy };
      };
      const at = (s: number, pts = truth) => pts[Math.round(s * N)];

      // start
      const s0 = box(at(0), C.fg);
      const startLines = narrow ? ['known start:', 'position, velocity,', 'heading'] : ['known start:', 'position, velocity, heading'];
      startLines.forEach((t, i) => label(ctx, t, s0.cx - B / 2, s0.cy - B / 2 - 12 - (startLines.length - 1 - i) * (fs + 4), C.soft, { size: fs }));

      // straight section: nothing to feel
      const s1 = box(at(0.15), C.fg);
      label(ctx, narrow ? 'straight, constant speed:' : 'straight at constant speed:', s1.cx, s1.cy + B / 2 + 14, C.soft, { size: fs, align: 'center' });
      label(ctx, 'nothing to feel', s1.cx, s1.cy + B / 2 + 14 + fs + 4, C.soft, { size: fs, align: 'center' });

      // in the left turn: sideways push towards the centre of the curve and a turn rate
      const pt = at(0.38), s2 = box(pt, C.fg);
      const nx = -Math.sin(pt.h), ny = Math.cos(pt.h);                  // left normal in model coordinates
      const L = narrow ? 30 : 40;
      arrow(ctx, s2.cx, s2.cy, s2.cx + nx * L, s2.cy - ny * L, C.accent, 2.25, 8);
      label(ctx, '$\\b{f}$', s2.cx + nx * (L + 10), s2.cy - ny * (L + 10), C.accent, { size: fs + 2, align: 'center', weight: 600 });
      // turn-rate arc around the box
      const r = B * 0.95;
      // a left turn is counter-clockwise on screen: draw the arc on the right-hand side of the box, head in turning direction
      const th0 = -pt.h + 2.2, th1 = -pt.h + 0.35;
      ctx.strokeStyle = C.accent; ctx.lineWidth = 1.75; ctx.beginPath();
      ctx.arc(s2.cx, s2.cy, r, th0, th1, true); ctx.stroke();
      const hx = s2.cx + r * Math.cos(th1), hy = s2.cy + r * Math.sin(th1);
      arrow(ctx, hx - 7 * Math.sin(th1), hy + 7 * Math.cos(th1), hx + Math.sin(th1), hy - Math.cos(th1), C.accent, 1.75, 7);
      label(ctx, '$\\omega$', s2.cx + (r + 11) * Math.cos(-pt.h + 1.25), s2.cy + (r + 11) * Math.sin(-pt.h + 1.25), C.accent, { size: fs + 2, align: 'center', weight: 600 });
      const tx = s2.cx + (narrow ? 14 : 30), ty = s2.cy + B / 2 + (narrow ? 26 : 30);
      label(ctx, 'in a turn: a sideways', tx, ty, C.soft, { size: fs });
      label(ctx, 'push $\\b{f}$ and a turn rate $\\omega$', tx, ty + fs + 4, C.soft, { size: fs });

      // end: true and computed position
      const eT = at(1), eE = at(1, est);
      ctx.strokeStyle = C.muted; ctx.lineWidth = 1; ctx.setLineDash([2, 3]);
      ctx.beginPath(); ctx.moveTo(X(eT), Y(eT)); ctx.lineTo(X(eE), Y(eE)); ctx.stroke(); ctx.setLineDash([]);
      const e1 = box(eT, C.fg), e2 = box(eE, C.accent, true);
      label(ctx, 'true position', e1.cx + B / 2, e1.cy + B / 2 + 14, C.fg, { size: fs, align: 'right' });
      label(ctx, 'computed position', e2.cx + B / 2, e2.cy - B / 2 - 12, C.accent, { size: fs, align: 'right' });
      const gx = (e1.cx + e2.cx) / 2, gy = (e1.cy + e2.cy) / 2;
      if (!narrow) label(ctx, 'drift', gx - 10, gy, C.muted, { size: fs, align: 'right' });
    }
  });
</script>
