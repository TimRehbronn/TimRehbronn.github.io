---
import M from '../../blog/M.astro';
// Complex planes inside the quaternions: for every unit direction u in the space of i, j, k, the numbers
// cos(phi) + u sin(phi) form a unit circle in the plane spanned by 1 and u, exactly like e^{i phi}.
---

<figure class="xp wide" data-xp="qplanes">
  <div class="xp-head"><span class="label fig-title">The complex plane inside the quaternions</span><span class="label" style="color:var(--muted)">drag the left view</span></div>
  <div class="xp-row two">
    <canvas class="c-u drag" role="img" aria-label="The three imaginary axes i, j and k with a chosen unit direction u"></canvas>
    <canvas class="c-p" role="img" aria-label="The plane spanned by 1 and u with the unit circle and the quaternion at angle phi"></canvas>
  </div>
  <div class="xp-btns">
    <button class="btn nocap" type="button" data-u="i" aria-pressed="true"><M t={String.raw`\mathbf u = i`} /></button>
    <button class="btn nocap" type="button" data-u="j" aria-pressed="false"><M t={String.raw`\mathbf u = j`} /></button>
    <button class="btn nocap" type="button" data-u="k" aria-pressed="false"><M t={String.raw`\mathbf u = k`} /></button>
    <button class="btn nocap" type="button" data-u="free" aria-pressed="false">any direction</button>
  </div>
  <div class="xp-controls">
    <label class="xp-ctl"><span><span>Angle <M t={String.raw`\varphi`} /></span><output for="ph"></output></span><input type="range" name="ph" min="-180" max="180" step="1" value="40" /></label>
    <label class="xp-ctl"><span><span>Direction of <M t={String.raw`\mathbf u`} />: azimuth</span><output for="az"></output></span><input type="range" name="az" min="-180" max="180" step="1" value="35" /></label>
    <label class="xp-ctl"><span><span>Direction of <M t={String.raw`\mathbf u`} />: elevation</span><output for="el"></output></span><input type="range" name="el" min="-80" max="80" step="1" value="30" /></label>
  </div>
  <p class="xp-readout" aria-live="polite">
    <span><M t={String.raw`\mathbf q = \cos\varphi + \mathbf u \sin\varphi`} /> = <b class="hot" data-o="q"></b></span>
    <span><M t={String.raw`\lVert \mathbf q \rVert`} /> = <b data-o="n"></b></span>
  </p>
  <figcaption><slot /></figcaption>
</figure>

<style>
  [data-xp='qplanes'] .nocap { text-transform: none; letter-spacing: 0.02em; }
</style>

<script>
  import { palette, setupCanvas, label, slider, arrow, outputs } from '../../../lib/explainer';
  import { camera, type V3 } from '../../../lib/rot';

  const D2R = Math.PI / 180;
  for (const fig of document.querySelectorAll<HTMLElement>('[data-xp="qplanes"]')) {
    const cu = fig.querySelector<HTMLCanvasElement>('.c-u')!, cp = fig.querySelector<HTMLCanvasElement>('.c-p')!;
    const out = outputs(fig);
    let mode = 'i', ph = 40, uaz = 35, uel = 30, az = 0.7, el = 0.35;
    const U = setupCanvas(cu, 1, () => draw()), Pc = setupCanvas(cp, 1, () => draw());

    const uvec = (): V3 => {
      if (mode === 'i') return [1, 0, 0];
      if (mode === 'j') return [0, 1, 0];
      if (mode === 'k') return [0, 0, 1];
      const a = uaz * D2R, e = uel * D2R; return [Math.cos(e) * Math.cos(a), Math.cos(e) * Math.sin(a), Math.sin(e)];
    };
    const uname = () => (mode === 'free' ? '$\\mathbf{u}$' : `$${mode}$`);

    function drawU() {
      const P = palette(), { ctx, size } = U, W = size.w, H = size.h;
      if (!W) return;
      ctx.clearRect(0, 0, W, H);
      const cam = camera(az, el, Math.min(W, H) * 0.32, W / 2, H / 2 + 10);
      const pr = (v: V3) => cam.project([v[0], -v[1], -v[2]]);   // k up on screen
      const o = pr([0, 0, 0]);
      for (const [v, n] of [[[1.3, 0, 0], '$i$'], [[0, 1.3, 0], '$j$'], [[0, 0, 1.3], '$k$']] as [V3, string][]) {
        const p = pr(v); arrow(ctx, o.x, o.y, p.x, p.y, P.soft, 1.25, 8); label(ctx, n, p.x + 6, p.y - 4, P.soft, { size: 14 });
      }
      // unit sphere outline (directions u)
      ctx.strokeStyle = P.border; ctx.beginPath(); ctx.arc(o.x, o.y, Math.min(W, H) * 0.32, 0, Math.PI * 2); ctx.stroke();
      const u = uvec(), pu = pr(u);
      arrow(ctx, o.x, o.y, pu.x, pu.y, P.accent, 2.5, 10);
      label(ctx, uname(), pu.x + 8, pu.y - 6, P.accent, { size: 15 });
      label(ctx, 'the imaginary directions (vector part)', 8, 12, P.soft, { size: 11 });
      label(ctx, 'every unit direction $\\mathbf{u}$ squares to $-1$', 8, H - 10, P.muted, { size: 11 });
    }

    function drawP() {
      const P = palette(), { ctx, size } = Pc, W = size.w, H = size.h;
      if (!W) return;
      ctx.clearRect(0, 0, W, H);
      const cx = W / 2, cy = H / 2 + 6, R = Math.min(W, H) * 0.32;
      ctx.strokeStyle = P.strong; ctx.lineWidth = 1; ctx.beginPath(); ctx.moveTo(cx - R * 1.35, cy); ctx.lineTo(cx + R * 1.35, cy); ctx.moveTo(cx, cy + R * 1.35); ctx.lineTo(cx, cy - R * 1.35); ctx.stroke();
      ctx.strokeStyle = P.soft; ctx.beginPath(); ctx.arc(cx, cy, R, 0, Math.PI * 2); ctx.stroke();
      label(ctx, '$1$', cx + R + 6, cy + 12, P.soft, { size: 13 });
      label(ctx, '$-1$', cx - R - 22, cy + 12, P.soft, { size: 13 });
      label(ctx, uname(), cx + 8, cy - R - 6, P.accent, { size: 14 });
      // q on the circle
      const a = ph * D2R, qx = cx + Math.cos(a) * R, qy = cy - Math.sin(a) * R;
      ctx.strokeStyle = P.accent; ctx.lineWidth = 1.5; ctx.beginPath(); ctx.arc(cx, cy, R * 0.28, 0, -a, a > 0); ctx.stroke();
      label(ctx, '$\\varphi$', cx + Math.cos(a / 2) * R * 0.4, cy - Math.sin(a / 2) * R * 0.4, P.accent, { size: 13, align: 'center' });
      arrow(ctx, cx, cy, qx, qy, P.accent, 2.5, 10);
      label(ctx, '$\\mathbf{q}$', qx + 8, qy - 6, P.accent, { size: 14 });
      // u * u = -1 hint: quarter turns
      ctx.fillStyle = P.fg; for (const [x, y] of [[cx + R, cy], [cx, cy - R], [cx - R, cy]]) { ctx.beginPath(); ctx.arc(x, y, 3, 0, Math.PI * 2); ctx.fill(); }
      label(ctx, mode === 'i' ? 'with $\\mathbf{u} = i$ this is the complex plane' : `the plane spanned by $1$ and ${uname()}`, 8, 12, P.soft, { size: 11 });
      const u = uvec(), s = Math.sin(a), c = Math.cos(a);
      out('q', `[${c.toFixed(3)}, ${(u[0] * s).toFixed(3)}, ${(u[1] * s).toFixed(3)}, ${(u[2] * s).toFixed(3)}]`);
      out('n', Math.hypot(c, s).toFixed(3));
    }

    function draw() { drawU(); drawP(); }
    const btns = fig.querySelectorAll<HTMLButtonElement>('[data-u]');
    let ready = false;
    function setMode(m: string) { mode = m; btns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.u === m))); draw(); }
    btns.forEach((b) => b.addEventListener('click', () => setMode(b.dataset.u!)));
    slider(fig, 'ph', (v) => `${v}°`, (v) => { ph = v; draw(); });
    slider(fig, 'az', (v) => `${v}°`, (v) => { uaz = v; if (ready && mode !== 'free') setMode('free'); else draw(); });
    slider(fig, 'el', (v) => `${v}°`, (v) => { uel = v; if (ready && mode !== 'free') setMode('free'); else draw(); });
    setMode('i');
    ready = true;

    let drag: { x: number; y: number; az: number; el: number } | null = null;
    cu.addEventListener('pointerdown', (e) => { drag = { x: e.clientX, y: e.clientY, az, el }; cu.setPointerCapture(e.pointerId); });
    cu.addEventListener('pointermove', (e) => { if (!drag) return; az = drag.az - (e.clientX - drag.x) * 0.01; el = Math.max(-1.4, Math.min(1.4, drag.el + (e.clientY - drag.y) * 0.01)); draw(); });
    cu.addEventListener('pointerup', () => (drag = null));
  }
</script>
