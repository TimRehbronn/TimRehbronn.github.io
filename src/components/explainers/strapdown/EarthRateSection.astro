---
import M from '../../blog/M.astro';
// Earth rate in the navigation frame: a meridian cross-section with the spin axis and a point at latitude L.
// The Earth-rate vector is drawn at the point, parallel to the spin axis, and split into a north and a vertical part.
---

<figure class="xp wide" data-xp="erate">
  <div class="xp-head"><span class="label fig-title">The Earth rate in north and down</span></div>
  <div class="xp-row two">
    <canvas class="c-g" role="img" aria-label="Cross-section of the Earth through the poles with the spin axis, a point at latitude L, its local horizontal and down direction, and the Earth-rate vector at the point split into a north and a vertical component"></canvas>
    <canvas class="c-p" role="img" aria-label="Plot of the north component and the down component of the Earth rate in degrees per hour against latitude, with the chosen latitude marked"></canvas>
  </div>
  <ul class="xp-legend">
    <li class="c-accent"><i></i><span>Earth rate <M t={String.raw`\boldsymbol\omega_{ie}`} />, parallel to the spin axis</span></li>
    <li class="c-fg"><i></i><span>north component <M t={String.raw`\omega_{ie}\cos L`} /></span></li>
    <li class="c-muted dash"><i></i><span>vertical component: <M t={String.raw`\omega_{ie}\sin L`} /> up, so <M t={String.raw`-\omega_{ie}\sin L`} /> down</span></li>
  </ul>
  <div class="xp-controls">
    <label class="xp-ctl"><span><span>Latitude <M t="L" /></span><output for="lat"></output></span><input type="range" name="lat" min="-90" max="90" step="1" value="51" /></label>
  </div>
  <div class="xp-btns"><button class="btn" type="button" data-act="sweep" aria-pressed="false">Sweep latitude</button></div>
  <p class="xp-readout" aria-live="polite">
    <span>north <M t={String.raw`\omega_{ie}\cos L`} /> = <b class="hot" data-o="n"></b></span>
    <span>east = <b>0 °/h</b></span>
    <span>down <M t={String.raw`-\omega_{ie}\sin L`} /> = <b class="hot" data-o="d"></b></span>
    <span><M t={String.raw`\omega_{ie}`} /> = <b>15.04 °/h</b></span>
  </p>
  <figcaption><slot /></figcaption>
</figure>

<script>
  import { palette, setupCanvas, animate, label, arrow, axes, series, outputs, reducedMotion } from '../../../lib/explainer';

  const D2R = Math.PI / 180, WIE_DEGH = (7.292115e-5 * 180 * 3600) / Math.PI;
  const num = (x: number, d = 2) => (Math.abs(x) < 0.5 * 10 ** -d ? (0).toFixed(d) : x.toFixed(d)).replace('-', '−');

  for (const fig of document.querySelectorAll<HTMLElement>('[data-xp="erate"]')) {
    const cg = fig.querySelector<HTMLCanvasElement>('.c-g')!, cp = fig.querySelector<HTMLCanvasElement>('.c-p')!;
    const out = outputs(fig);
    const input = fig.querySelector<HTMLInputElement>('input[name="lat"]')!, outLat = fig.querySelector<HTMLOutputElement>('output[for="lat"]')!;
    const btn = fig.querySelector<HTMLButtonElement>('[data-act="sweep"]')!;
    let lat = Number(input.value), sweeping = false, phase = Math.asin(lat / 85);
    const G = setupCanvas(cg, 0.95, () => draw()), Pl = setupCanvas(cp, 0.95, () => draw());

    // polyline arc in math orientation (angles counter-clockwise, y up)
    const arcM = (ctx: CanvasRenderingContext2D, x: number, y: number, r: number, a0: number, a1: number) => {
      ctx.beginPath();
      for (let i = 0; i <= 32; i++) { const a = a0 + ((a1 - a0) * i) / 32; i ? ctx.lineTo(x + r * Math.cos(a), y - r * Math.sin(a)) : ctx.moveTo(x + r * Math.cos(a), y - r * Math.sin(a)); }
      ctx.stroke();
    };

    function drawGlobe() {
      const P = palette(), { ctx, size } = G, W = size.w, H = size.h;
      if (!W) return;
      ctx.clearRect(0, 0, W, H);
      const R = Math.min(W * 0.28, H * 0.27), cx = W * 0.4, cy = H * 0.6;
      const L = lat * D2R, cL = Math.cos(L), sL = Math.sin(L);
      const X = (x: number) => cx + x, Y = (y: number) => cy - y;

      // Earth, equator, spin axis
      ctx.strokeStyle = P.strong; ctx.lineWidth = 1.25; ctx.beginPath(); ctx.arc(cx, cy, R, 0, Math.PI * 2); ctx.stroke();
      ctx.strokeStyle = P.border; ctx.lineWidth = 1; ctx.beginPath(); ctx.moveTo(cx - R - 14, cy); ctx.lineTo(cx + R + 14, cy); ctx.stroke();
      label(ctx, 'equator', cx - R - 12, cy + 11, P.muted, { size: 10 });
      ctx.strokeStyle = P.muted; ctx.setLineDash([4, 4]); ctx.beginPath(); ctx.moveTo(cx, cy + R + 16); ctx.lineTo(cx, cy - R); ctx.stroke(); ctx.setLineDash([]);
      arrow(ctx, cx, cy - R, cx, cy - R - 0.42 * R, P.muted, 1.25, 8);
      label(ctx, 'spin axis', cx - 8, cy - R - 0.36 * R, P.muted, { size: 10, align: 'right' });
      // little turning arrow around the axis (the Earth turns eastward, counter-clockwise seen from the north)
      ctx.strokeStyle = P.muted; ctx.lineWidth = 1; ctx.beginPath(); ctx.ellipse(cx, cy - R - 0.2 * R, 13, 4, 0, 0.15 * Math.PI, 1.85 * Math.PI); ctx.stroke();

      // the point, its radius and the latitude angle at the centre
      const px = R * cL, py = R * sL, Px = X(px), Py = Y(py);
      ctx.strokeStyle = P.border; ctx.setLineDash([3, 4]); ctx.beginPath(); ctx.moveTo(cx, cy); ctx.lineTo(Px, Py); ctx.stroke(); ctx.setLineDash([]);
      if (Math.abs(lat) > 3) {
        ctx.strokeStyle = P.muted; ctx.lineWidth = 1; arcM(ctx, cx, cy, 26, 0, L);
        label(ctx, '$L$', cx + 38 * Math.cos(L / 2), cy - 38 * Math.sin(L / 2), P.muted, { size: 12, align: 'center' });
      }

      // local frame at the point: north along the horizontal, down towards the centre
      const n = [-sL, cL], u = [cL, sL];
      ctx.strokeStyle = P.strong; ctx.lineWidth = 1;
      const ell = 0.95 * R, hn = Math.max(0.45 * R, ell * Math.abs(cL) + 0.22 * R);
      ctx.beginPath(); ctx.moveTo(X(px - n[0] * 0.5 * R), Y(py - n[1] * 0.5 * R)); ctx.lineTo(X(px + n[0] * hn), Y(py + n[1] * hn)); ctx.stroke();
      label(ctx, 'N', X(px + n[0] * (hn + 4) + u[0] * 12), Y(py + n[1] * (hn + 4) + u[1] * 12), P.soft, { size: 12, align: 'center', weight: 700 });
      label(ctx, 'local horizontal', X(px - n[0] * 0.5 * R) + 4, Y(py - n[1] * 0.5 * R) + (sL >= 0 ? 4 : 9), P.muted, { size: 10, align: 'left' });
      // local vertical: thin line through the point, arrow towards down
      const dl = 0.34 * R, ul = Math.max(0.2 * R, sL > 0 ? ell * sL + 0.12 * R : 0);
      ctx.beginPath(); ctx.moveTo(X(px + u[0] * ul), Y(py + u[1] * ul)); ctx.lineTo(Px, Py); ctx.stroke();
      arrow(ctx, Px, Py, X(px - u[0] * dl), Y(py - u[1] * dl), P.strong, 1.25, 7);
      const dlab = sL < -0.2 ? [px - u[0] * dl + n[0] * 13, py - u[1] * dl + n[1] * 13] : [px - u[0] * (dl + 11), py - u[1] * (dl + 11)];
      label(ctx, 'D', X(dlab[0]), Y(dlab[1]), P.soft, { size: 12, align: 'center', weight: 700 });

      // Earth rate at the point and its two components
      const tip = [px, py + ell], nc = [px + n[0] * ell * cL, py + n[1] * ell * cL], uc = [px + u[0] * ell * sL, py + u[1] * ell * sL];
      ctx.strokeStyle = P.border; ctx.lineWidth = 1; ctx.setLineDash([3, 3]);
      ctx.beginPath(); ctx.moveTo(X(nc[0]), Y(nc[1])); ctx.lineTo(X(tip[0]), Y(tip[1])); ctx.lineTo(X(uc[0]), Y(uc[1])); ctx.stroke();
      ctx.setLineDash([]);
      arrow(ctx, Px, Py, X(nc[0]), Y(nc[1]), P.fg, 2.25, 9);
      ctx.setLineDash([5, 3]); arrow(ctx, Px, Py, X(uc[0]), Y(uc[1]), P.muted, 2.25, 9); ctx.setLineDash([]);
      arrow(ctx, Px, Py, X(tip[0]), Y(tip[1]), P.accent, 2.75, 10);
      label(ctx, '$\\boldsymbol\\omega_{ie}$', X(tip[0]) - 8, Y(tip[1]) - 2, P.accent, { size: 14, align: 'right' });

      // angle L between the local horizontal (north) and the spin-axis direction
      if (Math.abs(lat) > 3) {
        ctx.strokeStyle = P.accent; ctx.lineWidth = 1.25; arcM(ctx, Px, Py, 0.22 * R, Math.PI / 2, Math.PI / 2 + L);
        const am = Math.PI / 2 + L / 2, ar = 0.22 * R + 11;
        label(ctx, '$L$', Px + ar * Math.cos(am), Py - ar * Math.sin(am), P.accent, { size: 12, align: 'center' });
      }
      // component labels, placed beside the arrows on the side away from the vector
      if (Math.abs(cL) > 0.35) {
        const sg = sL >= 0 ? 1 : -1, off = 10 + 30 * Math.abs(cL) + 7 * Math.abs(sL), m = [nc[0] - sg * u[0] * off, nc[1] - sg * u[1] * off];
        label(ctx, '$\\omega_{ie}$ cos $L$', X(m[0]), Y(m[1]), P.fg, { size: 11, align: 'center' });
      }
      if (Math.abs(sL) > 0.12) {
        const off = 10 + 30 * Math.abs(sL) + 7 * Math.abs(cL), e = [(px + uc[0]) / 2 - n[0] * off, (py + uc[1]) / 2 - n[1] * off];
        label(ctx, '$\\omega_{ie}$ sin $L$', X(e[0]), Y(e[1]), P.muted, { size: 11, align: 'center' });
      }
      ctx.fillStyle = P.fg; ctx.beginPath(); ctx.arc(Px, Py, 4, 0, Math.PI * 2); ctx.fill();
      const hemi = lat > 0 ? 'northern hemisphere: vertical part points up' : lat < 0 ? 'southern hemisphere: vertical part points down' : 'equator: no vertical part';
      label(ctx, hemi, 8, H - 10, P.muted, { size: 10 });
    }

    function drawPlot() {
      const P = palette(), { ctx, size } = Pl, W = size.w, H = size.h;
      if (!W) return;
      ctx.clearRect(0, 0, W, H);
      const b = { x: 42, y: 24, w: W - 54, h: H - 66 };
      const { sx, sy } = axes(ctx, P, b, [-90, 90], [-17, 17], { xfmt: (v) => `${v}°`, xticks: 6, yticks: 6, zeroLine: true, xlabel: 'latitude $L$', ylabel: '°/h' });
      const xs: number[] = [], yn: number[] = [], yd: number[] = [];
      for (let i = 0; i <= 180; i++) { const l = -90 + i; xs.push(l); yn.push(WIE_DEGH * Math.cos(l * D2R)); yd.push(-WIE_DEGH * Math.sin(l * D2R)); }
      series(ctx, b, xs, yn, sx, sy, P.fg, 2);
      series(ctx, b, xs, yd, sx, sy, P.muted, 2, [6, 4]);
      label(ctx, 'north $\\omega_{ie}$ cos $L$', sx(0), sy(WIE_DEGH) + 14, P.fg, { size: 11, align: 'center' });
      label(ctx, 'down $-\\omega_{ie}$ sin $L$', sx(-86), sy(-12.5), P.muted, { size: 11 });
      // marker at the chosen latitude
      const x = sx(lat), vn = WIE_DEGH * Math.cos(lat * D2R), vd = -WIE_DEGH * Math.sin(lat * D2R);
      ctx.strokeStyle = P.accent; ctx.lineWidth = 1; ctx.beginPath(); ctx.moveTo(x, b.y); ctx.lineTo(x, b.y + b.h); ctx.stroke();
      // value labels on the side of the dot away from the curve
      for (const [v, slope, col] of [[vn, -Math.sin(lat * D2R), P.fg], [vd, -Math.cos(lat * D2R), P.muted]] as [number, number, string][]) {
        ctx.fillStyle = P.accent; ctx.beginPath(); ctx.arc(x, sy(v), 4.5, 0, Math.PI * 2); ctx.fill();
        let right = slope <= 0;
        if (right && lat > 60) right = false; else if (!right && lat < -60) right = true;
        const up = right === slope <= 0;
        label(ctx, num(v, 1), x + (right ? 8 : -8), sy(v) + (up ? -10 : 12), col, { size: 11, align: right ? 'left' : 'right' });
      }
    }

    function draw() {
      drawGlobe(); drawPlot();
      out('n', `${num(WIE_DEGH * Math.cos(lat * D2R))} °/h`);
      out('d', `${num(-WIE_DEGH * Math.sin(lat * D2R))} °/h`);
    }
    const setLat = (v: number) => { lat = v; input.value = String(Math.round(v)); outLat.textContent = `${Math.round(v)}°`; draw(); };
    input.addEventListener('input', () => { setLat(Number(input.value)); phase = Math.asin(Math.max(-1, Math.min(1, lat / 85))); });
    setLat(lat);

    const anim = animate(fig, (dt) => { phase += dt * 0.6; setLat(85 * Math.sin(phase)); }, () => sweeping);
    if (reducedMotion()) btn.style.display = 'none';
    btn.addEventListener('click', () => {
      sweeping = !sweeping;
      btn.setAttribute('aria-pressed', String(sweeping));
      anim.kick();
    });
  }
</script>
