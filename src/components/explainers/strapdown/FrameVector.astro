---
import M from '../../blog/M.astro';
// One physical vector, written in different frames: superscript = axes, subscripts = "of what relative to what".
---

<figure class="xp wide" data-xp="fvec">
  <div class="xp-head"><span class="label fig-title">One vector, different frames</span></div>
  <div class="xp-row two">
    <canvas role="img" aria-label="Top view of a ship with north-east axes and body axes; its velocity vector is decomposed into components along the chosen axes"></canvas>
    <div class="fv-side">
      <p class="label">Resolve the velocity in</p>
      <div class="xp-btns" style="margin-top:0.3rem">
        <button class="btn" type="button" data-res="n" aria-pressed="true">navigation axes n</button>
        <button class="btn" type="button" data-res="b" aria-pressed="false">body axes b</button>
      </div>
      <table class="fv-t">
        <tbody>
          <tr><td><M t={String.raw`\mathbf v_{eb}^n`} /></td><td>=</td><td data-o="vn"></td><td class="u">m/s</td></tr>
          <tr><td><M t={String.raw`\mathbf v_{eb}^b`} /></td><td>=</td><td data-o="vb"></td><td class="u">m/s</td></tr>
          <tr><td><M t={String.raw`\lVert \mathbf v_{eb} \rVert`} /></td><td>=</td><td data-o="vv"></td><td class="u">m/s</td></tr>
          <tr><td><M t={String.raw`\mathbf v_{ib}^n`} /></td><td>=</td><td data-o="vi"></td><td class="u">m/s</td></tr>
        </tbody>
      </table>
      <p class="small muted fv-note">Same arrow, different numbers: the superscript only chooses the axes. The subscripts choose the motion: relative to the Earth (<M t="e" />) the ship moves at a few m/s, relative to inertial space (<M t="i" />) it also rides along with the Earth's rotation, about <span data-o="ve"></span> m/s eastward at latitude <span data-o="lat"></span>.</p>
    </div>
  </div>
  <ul class="xp-legend">
    <li class="c-muted"><i></i><span>navigation axes N, E</span></li>
    <li class="c-accent"><i></i><span>body axes <M t="x^b" /> (bow), <M t="y^b" /> (starboard)</span></li>
    <li class="c-fg"><i></i><span>velocity over ground <M t={String.raw`\mathbf v_{eb}`} /></span></li>
  </ul>
  <div class="xp-controls">
    <label class="xp-ctl"><span><span>Heading <M t={String.raw`\psi`} /></span><output for="hd"></output></span><input type="range" name="hd" min="0" max="359" step="1" value="40" /></label>
    <label class="xp-ctl"><span><span>Speed</span><output for="sp"></output></span><input type="range" name="sp" min="0" max="10" step="0.1" value="6" /></label>
    <label class="xp-ctl"><span><span>Drift angle from current <M t={String.raw`\beta`} /></span><output for="dr"></output></span><input type="range" name="dr" min="-30" max="30" step="1" value="12" /></label>
  </div>
  <figcaption><slot /></figcaption>
</figure>

<style>
  .fv-side { min-width: 0; }
  .fv-side .label { margin: 0; }
  .fv-t { border-collapse: collapse; margin: 0.9rem 0 0; font-variant-numeric: tabular-nums; }
  .fv-t td { border: 0; padding: 0.3rem 0.4rem; text-align: left; color: var(--fg); white-space: nowrap; }
  .fv-t td.u { color: var(--muted); }
  .fv-note { margin: 0.8rem 0 0; text-align: left; }
</style>

<script>
  import { palette, setupCanvas, label, slider, arrow, outputs } from '../../../lib/explainer';

  const D2R = Math.PI / 180, LAT = 51, VEARTH = 7.292115e-5 * 6378137 * Math.cos(LAT * D2R);

  for (const fig of document.querySelectorAll<HTMLElement>('[data-xp="fvec"]')) {
    const canvas = fig.querySelector('canvas')!;
    const out = outputs(fig);
    let hd = 40, sp = 6, dr = 12, res: 'n' | 'b' = 'n';
    const { ctx, size } = setupCanvas(canvas, 0.95, draw);
    out('ve', VEARTH.toFixed(0)); out('lat', `${LAT}°`);

    function draw() {
      const P = palette(), W = size.w, H = size.h;
      if (!W) return;
      ctx.clearRect(0, 0, W, H);
      const cx = W / 2, cy = H / 2, S = Math.min(W, H) * 0.42;
      const psi = hd * D2R, crs = (hd + dr) * D2R;
      const vN = sp * Math.cos(crs), vE = sp * Math.sin(crs);
      const vx = sp * Math.cos(dr * D2R), vy = sp * Math.sin(dr * D2R);
      // screen: east = +x, north = −y
      const scr = (n: number, e: number) => ({ x: cx + e, y: cy - n });
      const k = S / 10; // px per m/s
      // ship hull
      const hull = [[1.1, 0], [0.5, 0.32], [-0.9, 0.32], [-0.9, -0.32], [0.5, -0.32]].map(([a, b]) => {
        const n = (a * Math.cos(psi) - b * Math.sin(psi)) * S * 0.35, e = (a * Math.sin(psi) + b * Math.cos(psi)) * S * 0.35;
        return scr(n, e);
      });
      ctx.beginPath(); hull.forEach((p, i) => (i ? ctx.lineTo(p.x, p.y) : ctx.moveTo(p.x, p.y))); ctx.closePath();
      ctx.strokeStyle = P.strong; ctx.lineWidth = 1; ctx.stroke();

      const axisLen = S * 0.95;
      const nav: [number, number, string][] = [[1, 0, 'N'], [0, 1, 'E']];
      const body: [number, number, string][] = [[Math.cos(psi), Math.sin(psi), '$x^b$'], [-Math.sin(psi), Math.cos(psi), '$y^b$']];
      const drawAxes = (ax: typeof nav, col: string, w: number) => {
        for (const [n, e, name] of ax) {
          const p = scr(n * axisLen, e * axisLen), q = scr(-n * axisLen, -e * axisLen);
          ctx.strokeStyle = col; ctx.globalAlpha = 0.35; ctx.lineWidth = 1; ctx.setLineDash([3, 4]);
          ctx.beginPath(); ctx.moveTo(q.x, q.y); ctx.lineTo(cx, cy); ctx.stroke(); ctx.setLineDash([]); ctx.globalAlpha = 1;
          arrow(ctx, cx, cy, p.x, p.y, col, w, 9);
          label(ctx, name, p.x + 6, p.y - 6, col, { size: 13, weight: 700 });
        }
      };
      drawAxes(nav, P.muted, 1.25);
      drawAxes(body, P.accent, 1.75);

      // decomposition along the selected axes
      const ax = res === 'n' ? nav : body;
      const comps = res === 'n' ? [vN, vE] : [vx, vy];
      const tip = scr(vN * k, vE * k);
      ax.forEach(([n, e], i) => {
        const c = comps[i], f = scr(n * c * k, e * c * k);
        ctx.strokeStyle = res === 'n' ? P.soft : P.accent; ctx.lineWidth = 1; ctx.setLineDash([4, 3]);
        ctx.beginPath(); ctx.moveTo(tip.x, tip.y); ctx.lineTo(f.x, f.y); ctx.stroke(); ctx.setLineDash([]);
        ctx.lineWidth = 4; ctx.globalAlpha = 0.6; ctx.beginPath(); ctx.moveTo(cx, cy); ctx.lineTo(f.x, f.y); ctx.stroke(); ctx.globalAlpha = 1;
        label(ctx, c.toFixed(2), f.x + (i ? 0 : 8), f.y + (i ? 14 : 0), res === 'n' ? P.soft : P.accent, { size: 11, align: i ? 'center' : 'left' });
      });
      arrow(ctx, cx, cy, tip.x, tip.y, P.fg, 2.5, 11);
      label(ctx, '$\\mathbf{v}_{eb}$', tip.x + 8, tip.y - 8, P.fg, { size: 13 });
      label(ctx, 'grid unit: 1 m/s', 8, H - 10, P.muted, { size: 11 });

      const v2 = (a: number, b: number) => `[${a.toFixed(2)}, ${b.toFixed(2)}]ᵀ`;
      out('vn', v2(vN, vE)); out('vb', v2(vx, vy)); out('vv', sp.toFixed(2)); out('vi', v2(vN, vE + VEARTH));
    }

    slider(fig, 'hd', (v) => `${v}°`, (v) => { hd = v; draw(); });
    slider(fig, 'sp', (v) => `${v.toFixed(1)} m/s`, (v) => { sp = v; draw(); });
    slider(fig, 'dr', (v) => `${v}°`, (v) => { dr = v; draw(); });
    const btns = fig.querySelectorAll<HTMLButtonElement>('[data-res]');
    btns.forEach((b) => b.addEventListener('click', () => { res = b.dataset.res as 'n' | 'b'; btns.forEach((x) => x.setAttribute('aria-pressed', String(x === b))); draw(); }));
  }
</script>
