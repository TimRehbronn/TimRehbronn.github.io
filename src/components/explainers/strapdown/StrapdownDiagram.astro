---
import M from '../../blog/M.astro';
// Block diagram of the strapdown algorithm. Lines and arrows are SVG; boxes and labels are HTML positioned on top
// in percent of an 800 x 320 grid, with font sizes in container units so that everything scales together
// (no foreignObject, which some browsers do not scale reliably).
const GW = 800, GH = 320;
const pos = (x: number, y: number, w?: number, h?: number) =>
  `left:${(x / GW) * 100}%;top:${(y / GH) * 100}%;` + (w ? `width:${(w / GW) * 100}%;` : '') + (h ? `height:${(h / GH) * 100}%;` : '');
const boxes = [
  { x: 10, y: 20, w: 130, h: 54, title: 'Gyroscopes', tex: '\\boldsymbol\\omega_{ib}^b', hot: false },
  { x: 10, y: 130, w: 130, h: 54, title: 'Accelerometers', tex: '\\mathbf f_{ib}^b', hot: false },
  { x: 200, y: 20, w: 170, h: 54, title: 'Attitude update', tex: '\\mathbf C_b^n \\leftarrow \\mathbf C_b^n \\exp([\\boldsymbol\\alpha\\times])', hot: true },
  { x: 200, y: 130, w: 170, h: 54, title: 'Resolve specific force', tex: '\\mathbf f^n = \\mathbf C_b^n \\mathbf f_{ib}^b', hot: true },
  { x: 480, y: 130, w: 140, h: 54, title: 'Velocity update', tex: '\\mathbf v^n \\leftarrow \\mathbf v^n + \\dot{\\mathbf v}^n \\Delta t', hot: true },
  { x: 660, y: 130, w: 130, h: 54, title: 'Position update', tex: 'L,\\ \\lambda,\\ h', hot: true },
  { x: 430, y: 250, w: 360, h: 58, title: 'Earth model', tex: '\\mathbf g^n(L, h),\\ \\boldsymbol\\omega_{ie}^n,\\ \\boldsymbol\\omega_{en}^n,\\ R_N,\\ R_E', hot: false },
];
// line labels: anchor point and alignment
const labels = [
  { x: 292, y: 101, tex: '\\mathbf C_b^n', align: 'left' },
  { x: 770, y: 26, tex: '\\text{attitude } \\mathbf C_b^n', align: 'right' },
  { x: 640, y: 144, tex: '\\mathbf v^n', align: 'center' },
  { x: 448, y: 214, tex: '\\mathbf g^n - (2\\boldsymbol\\omega_{ie}^n + \\boldsymbol\\omega_{en}^n) \\times \\mathbf v^n', align: 'left', small: true },
  { x: 398, y: 101, tex: '\\boldsymbol\\omega_{in}^n', align: 'left' },
  { x: 732, y: 216, tex: 'L,\\ h', align: 'left' },
  { x: 612, y: 216, tex: '\\mathbf v^n', align: 'left' },
];
---

<figure class="xp wide sd">
  <div class="xp-head"><span class="label fig-title">The strapdown algorithm at a glance</span></div>
  <div class="sd-scroll">
    <div class="sd-canvas" role="img" aria-label="Block diagram: gyroscopes feed the attitude update; accelerometer outputs are resolved into the navigation frame, gravity and Coriolis terms are added, then velocity and position are integrated; an Earth model feeds gravity and frame rotation rates back.">
      <svg viewBox={`0 0 ${GW} ${GH}`} aria-hidden="true">
        <defs>
          <marker id="sd-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" class="sd-head" /></marker>
        </defs>
        <g class="sd-line">
          <path d="M140 47 H198" /><path d="M140 157 H198" /><path d="M285 74 V128" />
          <path d="M370 157 H415" /><path d="M443 157 H478" /><path d="M620 157 H658" />
          <path d="M370 47 H790" />
          <path d="M725 184 V248" /><path d="M605 184 V248" />
          <path d="M440 250 V172" />
          <path d="M430 272 H392 V62 H372" />
        </g>
        {boxes.map((b) => <rect x={b.x} y={b.y} width={b.w} height={b.h} class:list={['sd-rect', { hot: b.hot }]} />)}
        <circle cx="430" cy="157" r="13" class="sd-sum" />
      </svg>
      {boxes.map((b) => (
        <div class="sd-box" style={pos(b.x, b.y, b.w, b.h)}>
          <span class="sd-title">{b.title}</span>
          <span class="sd-tex"><M t={b.tex} /></span>
        </div>
      ))}
      <div class="sd-box sd-sigma" style={pos(417, 144, 26, 26)}><M t={String.raw`\Sigma`} /></div>
      {labels.map((l) => (
        <div class:list={['sd-lbl', l.align, { small: l.small }]} style={pos(l.x, l.y)}><M t={l.tex} /></div>
      ))}
    </div>
  </div>
  <figcaption><slot /></figcaption>
</figure>

<style>
  .sd .sd-scroll { overflow-x: auto; }
  .sd .sd-canvas { position: relative; width: 100%; min-width: 620px; aspect-ratio: 800 / 320; container-type: inline-size; }
  .sd svg { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .sd .sd-rect { fill: var(--bg); stroke: var(--border-strong); stroke-width: 1; }
  .sd .sd-rect.hot { stroke: var(--accent); }
  .sd .sd-sum { fill: var(--bg); stroke: var(--accent); }
  .sd .sd-line path { fill: none; stroke: var(--muted); stroke-width: 1.25; marker-end: url(#sd-arrow); }
  .sd .sd-head { fill: var(--muted); }
  .sd .sd-box {
    position: absolute; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.25cqw;
    color: var(--fg); text-align: center; line-height: 1.2; overflow: hidden; padding: 0 0.5cqw;
  }
  .sd .sd-title { font-size: 1.5cqw; white-space: nowrap; }
  .sd .sd-tex { font-size: 1.2cqw; color: var(--fg-soft); white-space: nowrap; }
  .sd .sd-sigma { font-size: 1.4cqw; }
  .sd .sd-lbl { position: absolute; font-size: 1.25cqw; color: var(--muted); white-space: nowrap; line-height: 1; }
  .sd .sd-lbl.small { font-size: 1.1cqw; }
  .sd .sd-lbl.center { transform: translateX(-50%); }
  .sd .sd-lbl.right { transform: translateX(-100%); }
  .sd :global(.katex) { font-size: 1.1em; }
</style>
