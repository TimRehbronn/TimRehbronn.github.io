---
import M from '../../blog/M.astro';
// Allan deviation step by step: cluster averages, neighbour differences, and sigma(tau) built up point by point.
---

<figure class="xp wide" data-xp="allanint">
  <div class="xp-head"><span class="label fig-title">The Allan deviation, one cluster time at a time</span></div>
  <div class="xp-btns">
    <button class="btn" type="button" data-sig="0" aria-pressed="true">White noise</button>
    <button class="btn" type="button" data-sig="1" aria-pressed="false">Random walk of the rate</button>
    <button class="btn" type="button" data-sig="2" aria-pressed="false">Constant bias with a step</button>
    <button class="btn" type="button" data-act="play" aria-pressed="false">Sweep the cluster time</button>
  </div>
  <div class="xp-row two">
    <canvas class="c-ts" role="img" aria-label="The signal with the averages over consecutive clusters of length tau and the differences between neighbouring averages"></canvas>
    <canvas class="c-ad" role="img" aria-label="Log-log plot of the Allan deviation over tau, filled in point by point up to the selected tau"></canvas>
  </div>
  <ul class="xp-legend">
    <li class="c-muted"><i></i><span>signal <M t={String.raw`\tilde\omega_j`} /></span></li>
    <li class="c-accent"><i></i><span>cluster averages <M t={String.raw`\bar\omega_k(\tau)`} /> and the current <M t={String.raw`\sigma(\tau)`} /></span></li>
    <li class="c-fg"><i></i><span>differences <M t={String.raw`\bar\omega_{k+1} - \bar\omega_k`} /> and <M t={String.raw`\sigma(\tau)`} /> for shorter <M t={String.raw`\tau`} /></span></li>
    <li class="c-muted dash"><i></i><span>theory</span></li>
  </ul>
  <div class="xp-controls">
    <label class="xp-ctl"><span><span>Cluster time <M t={String.raw`\tau`} /></span><output for="tau"></output></span><input type="range" name="tau" min="0" max="45" step="1" value="20" /></label>
  </div>
  <p class="xp-readout" aria-live="polite"><span>clusters <M t="M" /> = <b data-o="m"></b></span><span>rms of the differences = <b data-o="rms"></b></span><span><M t={String.raw`\sigma(\tau)`} /> = rms / <M t={String.raw`\sqrt2`} /> = <b class="hot" data-o="ad"></b></span></p>
  <figcaption><slot /></figcaption>
</figure>

<script>
  import { palette, setupCanvas, label, axes, series, rng, outputs, animate, reducedMotion, lazyInit } from '../../../lib/explainer';

  const FS = 10, DT = 1 / FS, T = 2000, N = T * FS;
  const SW = 4, KR = 0.05, STEP = 3, SW2 = 0.6;  // white noise per sample, rate random walk per sqrt(s), step height, noise on the step signal
  // cluster lengths in samples, log-spaced from 0.1 s to T/3
  const MS: number[] = [];
  for (let l = 0; l <= 46; l++) { const m = Math.round(10 ** (l / 46 * Math.log10((T / 3) * FS))); if (!MS.length || m > MS[MS.length - 1]) MS.push(m); }

  lazyInit('[data-xp="allanint"]', (fig) => {
    const cts = fig.querySelector<HTMLCanvasElement>('.c-ts')!, cad = fig.querySelector<HTMLCanvasElement>('.c-ad')!;
    const out = outputs(fig);
    const tauIn = fig.querySelector<HTMLInputElement>('input[name="tau"]')!;
    tauIn.max = String(MS.length - 1);
    let sig = 0, idx = Number(tauIn.value), playing = false, acc = 0;
    const y = new Float64Array(N), cs = new Float64Array(N + 1);
    let ad: number[] = [];
    const tStep = 0.62 * T;

    function generate() {
      const r = rng(5 + sig);
      let x = 0;
      for (let k = 0; k < N; k++) {
        if (sig === 0) y[k] = SW * r.gauss();
        else if (sig === 1) { y[k] = x; x += KR * Math.sqrt(DT) * r.gauss(); }
        else y[k] = 2 + (k * DT >= tStep ? STEP : 0) + SW2 * r.gauss();
      }
      for (let k = 0; k < N; k++) cs[k + 1] = cs[k] + y[k];
      // non-overlapping Allan deviation for every cluster length
      ad = MS.map((m) => {
        const M = Math.floor(N / m); let s = 0;
        for (let c = 0; c + 1 < M; c++) { const d = (cs[(c + 2) * m] - 2 * cs[(c + 1) * m] + cs[c * m]) / m; s += d * d; }
        return Math.sqrt(s / (2 * (M - 1)));
      });
    }
    const theory = (tau: number) => sig === 0 ? SW * Math.sqrt(DT / tau)
      : sig === 1 ? KR * Math.sqrt(tau / 3)
      : Math.sqrt((SW2 * SW2 * DT) / tau + (STEP * STEP) / (3 * Math.max(1e-9, T / tau - 1)));

    const A = setupCanvas(cts, (w) => Math.max(240, w * 0.62), drawTs);
    const B = setupCanvas(cad, (w) => Math.max(240, w * 0.62), drawAd);

    function drawTs() {
      const P = palette(), { ctx, size } = A, W = size.w, H = size.h;
      if (!W) return;
      ctx.clearRect(0, 0, W, H);
      const m = MS[idx], tau = m * DT, M = Math.floor(N / m);
      // show at least 12 clusters, at most the whole record; for the step signal, a window around the step
      const nShow = Math.min(M, Math.max(12, Math.ceil(400 / m)));
      const c0 = sig === 2 ? Math.max(0, Math.min(M - nShow, Math.floor(tStep / tau) - Math.floor(nShow / 2))) : 0;
      const k0w = c0 * m, show = nShow * m;
      const box = { x: 46, y: 8, w: W - 56, h: H - 40 };
      let lo = Infinity, hi = -Infinity;
      for (let k = k0w; k < k0w + show; k++) { lo = Math.min(lo, y[k]); hi = Math.max(hi, y[k]); }
      const pad = 0.08 * (hi - lo || 1);
      const Ax = axes(ctx, P, box, [k0w * DT, (k0w + show) * DT], [lo - pad, hi + pad], { ylabel: 'rate [°/h]', xlabel: 'time [s]', xfmt: (v) => `${+v.toFixed(1)}`, yfmt: (v) => `${+v.toFixed(2)}`, yticks: 4, xticks: 4 });
      const cols = Math.floor(box.w);
      ctx.strokeStyle = P.muted; ctx.lineWidth = 1; ctx.globalAlpha = 0.75;
      if (show <= cols) {
        const xs: number[] = [], ys: number[] = [];
        for (let k = k0w; k < k0w + show; k++) { xs.push(k * DT); ys.push(y[k]); }
        series(ctx, box, xs, ys, Ax.sx, Ax.sy, P.muted, 1);
      } else {
        for (let x = 0; x < cols; x++) {
          const k0 = k0w + Math.floor((x / cols) * show), k1 = Math.max(k0 + 1, k0w + Math.floor(((x + 1) / cols) * show));
          let a = Infinity, b = -Infinity; for (let k = k0; k < k1; k++) { a = Math.min(a, y[k]); b = Math.max(b, y[k]); }
          ctx.beginPath(); ctx.moveTo(box.x + x + 0.5, Ax.sy(a)); ctx.lineTo(box.x + x + 0.5, Ax.sy(b) - 0.5); ctx.stroke();
        }
      }
      ctx.globalAlpha = 1;
      const avg: number[] = [];
      for (let c = c0; c < c0 + nShow; c++) avg.push((cs[(c + 1) * m] - cs[c * m]) / m);
      ctx.strokeStyle = P.accent; ctx.lineWidth = 2.5;
      avg.forEach((v, i) => { const c = c0 + i; ctx.beginPath(); ctx.moveTo(Ax.sx(c * tau) + 1, Ax.sy(v)); ctx.lineTo(Ax.sx((c + 1) * tau) - 1, Ax.sy(v)); ctx.stroke(); });
      ctx.strokeStyle = P.fg; ctx.lineWidth = 2;
      for (let i = 1; i < avg.length; i++) { const x = Ax.sx((c0 + i) * tau); ctx.beginPath(); ctx.moveTo(x, Ax.sy(avg[i - 1])); ctx.lineTo(x, Ax.sy(avg[i])); ctx.stroke(); }
      if (sig === 2) label(ctx, 'step', Ax.sx(tStep) + 4, box.y + 12, P.soft, { size: 11 });
      label(ctx, `${nShow < M ? `${nShow} of ${M}` : `all ${M}`} clusters of $\\tau$ = ${fmtT(tau)}`, box.x + 6, box.y + box.h - 10, P.soft, { size: 11 });

      let s = 0; for (let c = 0; c + 1 < M; c++) { const d = (cs[(c + 2) * m] - 2 * cs[(c + 1) * m] + cs[c * m]) / m; s += d * d; }
      const rms = Math.sqrt(s / (M - 1));
      out('m', String(M)); out('rms', `${fmtV(rms)} °/h`); out('ad', `${fmtV(ad[idx])} °/h`);
    }

    function drawAd() {
      const P = palette(), { ctx, size } = B, W = size.w, H = size.h;
      if (!W || !ad.length) return;
      ctx.clearRect(0, 0, W, H);
      const box = { x: 52, y: 8, w: W - 62, h: H - 40 };
      const taus = MS.map((m) => m * DT), lx = taus.map(Math.log10);
      const yr: [number, number] = sig === 0 ? [1e-2, 1e1] : sig === 1 ? [1e-3, 1e0] : [1e-2, 1e1];
      const Ax = axes(ctx, P, box, [lx[0], lx[lx.length - 1]], yr, {
        logY: true, ylabel: 'Allan deviation $\\sigma(\\tau)$ [°/h]', xlabel: 'cluster time $\\tau$ [s]', xticks: 4,
        xfmt: (v) => (Math.abs(v - Math.round(v)) < 0.01 ? `${10 ** Math.round(v)}` : ''), yfmt: (v) => `$10^{${Math.round(Math.log10(v))}}$`,
      });
      series(ctx, box, lx, taus.map(theory), Ax.sx, Ax.sy, P.muted, 1.25, [5, 4]);
      series(ctx, box, lx, ad, Ax.sx, Ax.sy, P.fg, 1.25, [], idx + 1);
      ctx.fillStyle = P.fg;
      for (let i = 0; i < idx; i++) { ctx.beginPath(); ctx.arc(Ax.sx(lx[i]), Ax.sy(ad[i]), 2.5, 0, Math.PI * 2); ctx.fill(); }
      ctx.fillStyle = P.accent; ctx.beginPath(); ctx.arc(Ax.sx(lx[idx]), Ax.sy(ad[idx]), 5, 0, Math.PI * 2); ctx.fill();
      const txt = sig === 0 ? 'slope $-1/2$: averaging helps' : sig === 1 ? 'slope $+1/2$: averaging hurts' : 'noise falls, then the step dominates';
      label(ctx, txt, box.x + box.w - 8, box.y + 14, P.soft, { size: 11, align: 'right' });
    }

    const fmtT = (t: number) => (t >= 10 ? `${t.toFixed(0)} s` : `${t.toFixed(1)} s`);
    const fmtV = (v: number) => (v >= 1 ? v.toFixed(2) : v >= 0.01 ? v.toFixed(3) : v.toExponential(1));
    const outT = fig.querySelector<HTMLOutputElement>('output[for="tau"]')!;
    const setIdx = (i: number) => { idx = i; tauIn.value = String(i); outT.textContent = fmtT(MS[i] * DT); drawTs(); drawAd(); };
    tauIn.addEventListener('input', () => { playing = false; playBtn.setAttribute('aria-pressed', 'false'); setIdx(Number(tauIn.value)); });
    const sb = fig.querySelectorAll<HTMLButtonElement>('[data-sig]');
    sb.forEach((b) => b.addEventListener('click', () => { sig = Number(b.dataset.sig); sb.forEach((x) => x.setAttribute('aria-pressed', String(x === b))); generate(); setIdx(idx); }));

    const playBtn = fig.querySelector<HTMLButtonElement>('[data-act="play"]')!;
    const anim = animate(fig, (dt) => {
      acc += dt;
      if (acc < 0.18) return;
      acc = 0;
      if (idx >= MS.length - 1) { playing = false; playBtn.setAttribute('aria-pressed', 'false'); return; }
      setIdx(idx + 1);
    }, () => playing);
    playBtn.addEventListener('click', () => {
      if (reducedMotion()) { setIdx(MS.length - 1); return; }
      playing = !playing; playBtn.setAttribute('aria-pressed', String(playing));
      if (playing) { if (idx >= MS.length - 1) setIdx(0); anim.kick(); }
    });

    generate(); setIdx(idx);
  });
</script>
