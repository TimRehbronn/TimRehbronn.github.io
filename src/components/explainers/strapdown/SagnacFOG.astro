---
import M from '../../blog/M.astro';
// The Sagnac effect in a fiber-optic gyro: two counter-propagating light waves, their arrival-time difference,
// and how the interferometer output turns the phase difference into a signal.
---

<figure class="xp wide" data-xp="fog">
  <div class="xp-head"><span class="label fig-title">The Sagnac effect in a fiber-optic gyro</span></div>
  <div class="xp-row two">
    <canvas class="c-a" role="img" aria-label="A rotating fiber loop with two light pulses travelling in opposite directions; the pulse travelling with the rotation arrives later"></canvas>
    <canvas class="c-i" role="img" aria-label="Interferometer output intensity as a function of the phase difference, with the operating points with and without bias modulation"></canvas>
  </div>
  <ul class="xp-legend">
    <li class="c-accent"><i></i><span>light travelling with the rotation</span></li>
    <li class="c-fg"><i></i><span>light travelling against the rotation</span></li>
    <li class="c-muted"><i></i><span>detector intensity <M t={String.raw`I(\Delta\phi) = \tfrac{I_0}{2}(1 + \cos\Delta\phi)`} /></span></li>
  </ul>
  <div class="xp-controls">
    <label class="xp-ctl"><span><span>Rotation rate <M t={String.raw`\Omega`} /></span><output for="om"></output></span><input type="range" name="om" min="-3" max="6.5" step="0.05" value="1.18" /></label>
    <label class="xp-ctl"><span><span>Fiber length <M t="L" /></span><output for="len"></output></span><input type="range" name="len" min="1" max="3.7" step="0.05" value="3" /></label>
    <label class="xp-ctl"><span><span>Coil diameter <M t="D" /></span><output for="dia"></output></span><input type="range" name="dia" min="2" max="20" step="0.5" value="10" /></label>
  </div>
  <div class="xp-btns">
    <button class="btn" type="button" data-act="mod" aria-pressed="true">Bias modulation on</button>
  </div>
  <p class="xp-readout" aria-live="polite">
    <span>phase difference <M t={String.raw`\Delta\phi`} /> = <b class="hot" data-o="dphi"></b></span>
    <span>at Earth rate: <b data-o="earth"></b></span>
    <span>signal change: <b data-o="sig"></b> of <M t="I_0" /></span>
  </p>
  <figcaption><slot /></figcaption>
</figure>

<script>
  import { palette, setupCanvas, animate, label, slider, arrow, axes, outputs, reducedMotion, lazyInit } from '../../../lib/explainer';

  const C = 299792458, LAMBDA = 1550e-9, WIE = 7.292115e-5;
  const fmtRad = (x: number) => { const a = Math.abs(x); return a >= 0.1 ? `${x.toFixed(3)} rad` : a >= 1e-4 ? `${(x * 1e3).toFixed(3)} mrad` : a >= 1e-7 ? `${(x * 1e6).toFixed(3)} µrad` : `${(x * 1e9).toFixed(3)} nrad`; };

  lazyInit('[data-xp="fog"]', (fig) => {
    const ca = fig.querySelector<HTMLCanvasElement>('.c-a')!, ci = fig.querySelector<HTMLCanvasElement>('.c-i')!;
    const out = outputs(fig);
    const modBtn = fig.querySelector<HTMLButtonElement>('[data-act="mod"]')!;
    let lom = 1.18, llen = 3, dia = 10, mod = true, t = 0;
    const running = () => !reducedMotion();

    const A = setupCanvas(ca, 1, () => drawAnim());
    const I = setupCanvas(ci, 1, () => drawInt());

    const omega = () => (10 ** lom * Math.PI) / 180 / 3600;            // rad/s
    const dphi = (om = omega()) => (2 * Math.PI * 10 ** llen * (dia / 100) * om) / (LAMBDA * C);
    // exaggerated values for the pictures: grows with log of the rotation rate
    const visFrac = () => 0.04 + 0.22 * ((lom + 3) / 9.5);

    function drawAnim() {
      const P = palette(), { ctx, size } = A, W = size.w, H = size.h;
      if (!W) return;
      ctx.clearRect(0, 0, W, H);
      const cx = W / 2, cy = H / 2 + 6, R = Math.min(W, H) * 0.34;
      const wc = 1.6;                          // light speed in the picture [rad/s along the loop]
      const om = wc * visFrac();               // loop rotation in the picture
      const tCo = (2 * Math.PI) / (wc - om), tCounter = (2 * Math.PI) / (wc + om);
      const period = tCo + 1.2, tt = running() ? t % period : tCo;
      const s0 = -Math.PI / 2;                 // splitter starts at the bottom
      const sNow = s0 + om * tt;
      const pt = (a: number, r = R) => ({ x: cx + Math.cos(a) * r, y: cy - Math.sin(a) * r });
      // coil
      ctx.strokeStyle = P.strong; ctx.lineWidth = 6; ctx.beginPath(); ctx.arc(cx, cy, R, 0, Math.PI * 2); ctx.stroke();
      ctx.strokeStyle = P.bg; ctx.lineWidth = 3; ctx.beginPath(); ctx.arc(cx, cy, R, 0, Math.PI * 2); ctx.stroke();
      // rotation arrow
      ctx.strokeStyle = P.soft; ctx.lineWidth = 1.25; ctx.beginPath(); ctx.arc(cx, cy, R * 0.45, -0.6, 0.9); ctx.stroke();
      const ah = pt(0.9, R * 0.45); arrow(ctx, ah.x + 6, ah.y + 8, ah.x - 1, ah.y - 1, P.soft, 1.25, 7);
      label(ctx, '$\\Omega$', cx + R * 0.52, cy - 4, P.soft, { size: 14 });
      // splitter (moves with the loop) and start mark (fixed in space)
      const st = pt(s0, R + 14); ctx.strokeStyle = P.muted; ctx.setLineDash([3, 3]); ctx.beginPath(); ctx.moveTo(st.x, st.y - 22); ctx.lineTo(st.x, st.y + 6); ctx.stroke(); ctx.setLineDash([]);
      label(ctx, 'start', st.x, st.y + 16, P.muted, { size: 10, align: 'center' });
      const sp = pt(sNow); ctx.fillStyle = P.fg; ctx.fillRect(sp.x - 5, sp.y - 5, 10, 10);
      label(ctx, 'source / detector', sp.x + 10, sp.y + 14, P.soft, { size: 10 });
      // pulses: co-rotating (counter-clockwise, orange) and counter-rotating (clockwise, white)
      const draw = (dir: 1 | -1, col: string, tEnd: number) => {
        const tp = Math.min(tt, tEnd), a = s0 + dir * wc * tp;
        ctx.strokeStyle = col; ctx.lineWidth = 2.5; ctx.beginPath();
        dir > 0 ? ctx.arc(cx, cy, R, -s0 - wc * tp, -s0) : ctx.arc(cx, cy, R, -s0, -s0 + wc * tp);
        ctx.stroke();
        const p = pt(a); ctx.fillStyle = col; ctx.beginPath(); ctx.arc(p.x, p.y, 5, 0, Math.PI * 2); ctx.fill();
      };
      draw(-1, P.fg, tCounter);
      draw(1, P.accent, tCo);
      const msg = tt < tCounter ? 'both pulses are on their way' : tt < tCo ? 'the pulse against the rotation is already back' : 'both back: time difference $\\Delta t$';
      label(ctx, msg, 8, 12, P.soft, { size: 12 });
      label(ctx, 'rotation hugely exaggerated, light slowed down', 8, H - 10, P.muted, { size: 10 });
    }

    function drawInt() {
      const P = palette(), { ctx, size } = I, W = size.w, H = size.h;
      if (!W) return;
      ctx.clearRect(0, 0, W, H);
      const box = { x: 44, y: 24, w: W - 56, h: H - 62 };
      const Ax = axes(ctx, P, box, [-Math.PI, Math.PI], [0, 1.05], {
        ylabel: '$I / I_0$', xlabel: 'phase difference $\\Delta\\phi$ [rad]', yticks: 2, xticks: 4,
        xfmt: (v) => (Math.abs(v) < 1e-9 ? '0' : Math.abs(Math.abs(v) - Math.PI / 2) < 0.01 ? (v > 0 ? '$\\pi/2$' : '$-\\pi/2$') : ''), yfmt: (v) => v.toFixed(1),
      });
      ctx.strokeStyle = P.muted; ctx.lineWidth = 2; ctx.beginPath();
      for (let i = 0; i <= 200; i++) { const x = -Math.PI + (2 * Math.PI * i) / 200, y = 0.5 * (1 + Math.cos(x)); i ? ctx.lineTo(Ax.sx(x), Ax.sy(y)) : ctx.moveTo(Ax.sx(x), Ax.sy(y)); }
      ctx.stroke();
      const dv = 0.9 * visFrac();               // exaggerated phase for the picture
      const pts = mod ? [dv + Math.PI / 2, dv - Math.PI / 2] : [dv];
      const ref = mod ? [Math.PI / 2, -Math.PI / 2] : [0];
      ref.forEach((x) => { ctx.strokeStyle = P.strong; ctx.setLineDash([3, 3]); ctx.beginPath(); ctx.moveTo(Ax.sx(x), box.y); ctx.lineTo(Ax.sx(x), box.y + box.h); ctx.stroke(); ctx.setLineDash([]); });
      pts.forEach((x, k) => {
        const y = 0.5 * (1 + Math.cos(x)), y0 = 0.5 * (1 + Math.cos(ref[k]));
        ctx.fillStyle = k ? P.fg : P.accent; ctx.beginPath(); ctx.arc(Ax.sx(x), Ax.sy(y), 5, 0, Math.PI * 2); ctx.fill();
        ctx.strokeStyle = k ? P.fg : P.accent; ctx.lineWidth = 1.5; ctx.beginPath(); ctx.moveTo(Ax.sx(x), Ax.sy(y)); ctx.lineTo(Ax.sx(x), Ax.sy(y0)); ctx.stroke();
      });
      label(ctx, mod ? 'with $\\pm\\pi/2$ modulation: steep slope, sign is visible' : 'at the top of the curve: flat slope, sign is lost', 8, 12, P.soft, { size: 12 });
      label(ctx, 'phase exaggerated', box.x + box.w - 6, box.y + 12, P.muted, { size: 10, align: 'right' });

      const d = dphi();
      out('dphi', fmtRad(d)); out('earth', fmtRad(dphi(WIE)));
      const sig = mod ? Math.abs(Math.sin(d)) : (1 - Math.cos(d)) / 2;
      out('sig', sig >= 1e-3 ? sig.toFixed(4) : sig.toExponential(2));
    }

    const anim = animate(fig, (dt) => { t += dt; drawAnim(); }, running);
    slider(fig, 'om', (v) => { const d = 10 ** v; return d >= 3600 ? `${(d / 3600).toFixed(d >= 36000 ? 0 : 1)} °/s` : `${d >= 10 ? d.toFixed(0) : d >= 0.1 ? d.toFixed(2) : d.toFixed(3)} °/h`; }, (v) => { lom = v; t = 0; drawAnim(); drawInt(); anim.kick(); });
    slider(fig, 'len', (v) => { const l = 10 ** v; return l >= 1000 ? `${(l / 1000).toFixed(1)} km` : `${l.toFixed(0)} m`; }, (v) => { llen = v; drawInt(); });
    slider(fig, 'dia', (v) => `${v.toFixed(1)} cm`, (v) => { dia = v; drawInt(); });
    modBtn.addEventListener('click', () => { mod = !mod; modBtn.setAttribute('aria-pressed', String(mod)); modBtn.textContent = mod ? 'Bias modulation on' : 'Bias modulation off'; drawInt(); });
  });
</script>
