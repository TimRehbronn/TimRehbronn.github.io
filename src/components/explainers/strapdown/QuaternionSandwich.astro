---
import M from '../../blog/M.astro';
// A unit quaternion for a fixed axis u lives on a unit circle in the plane spanned by 1 and u, at half the
// rotation angle; the sandwich q v q* rotates a vector by the full angle. Up to 720° to show the double cover.
---

<figure class="xp wide" data-xp="qsand">
  <div class="xp-head"><span class="label fig-title">Quaternions: half the angle, twice applied</span><span class="label" style="color:var(--muted)">drag the right view</span></div>
  <div class="xp-row two">
    <canvas class="c-q" role="img" aria-label="The unit circle in the plane spanned by 1 and the rotation axis u; the quaternion sits at half the rotation angle"></canvas>
    <canvas class="c-v drag" role="img" aria-label="A vector rotated about the axis u by the full angle with the quaternion sandwich product"></canvas>
  </div>
  <ul class="xp-legend">
    <li class="c-accent"><i></i><span><M t={String.raw`\mathbf q = \cos\tfrac{\alpha}{2} + \mathbf u \sin\tfrac{\alpha}{2}`} /> and the rotated vector <M t={String.raw`\mathbf q \otimes \mathbf v \otimes \mathbf q^*`} /></span></li>
    <li class="c-fg"><i></i><span>original vector <M t={String.raw`\mathbf v`} /> and axis <M t={String.raw`\mathbf u`} /></span></li>
    <li class="c-muted dash"><i></i><span>vector part of <M t={String.raw`\mathbf q \otimes \mathbf v`} /> alone (only half the job)</span></li>
  </ul>
  <div class="xp-controls">
    <label class="xp-ctl"><span><span>Rotation angle <M t={String.raw`\alpha`} /></span><output for="al"></output></span><input type="range" name="al" min="0" max="720" step="1" value="120" /></label>
    <label class="xp-ctl"><span><span>Axis <M t={String.raw`\mathbf u`} />: azimuth</span><output for="az"></output></span><input type="range" name="az" min="-180" max="180" step="1" value="30" /></label>
    <label class="xp-ctl"><span><span>Axis <M t={String.raw`\mathbf u`} />: elevation</span><output for="el"></output></span><input type="range" name="el" min="-80" max="80" step="1" value="55" /></label>
  </div>
  <div class="xp-btns"><button class="btn" type="button" data-act="half" aria-pressed="false" style="text-transform:none;letter-spacing:0.02em">show <M t={String.raw`\mathbf q \otimes \mathbf v`} /> alone</button></div>
  <p class="xp-readout" aria-live="polite">
    <span><M t={String.raw`\mathbf q`} /> = <b class="hot" data-o="q"></b></span>
    <span><M t={String.raw`\mathbf q \otimes \mathbf v \otimes \mathbf q^*`} /> = <b data-o="vr"></b></span>
    <span>scalar part of <M t={String.raw`\mathbf q \otimes \mathbf v`} /> = <b data-o="s"></b></span>
  </p>
  <figcaption><slot /></figcaption>
</figure>

<script>
  import { palette, setupCanvas, label, slider, arrow, outputs } from '../../../lib/explainer';
  import { camera, qmul, qconj, type Q, type V3 } from '../../../lib/rot';

  const D2R = Math.PI / 180;
  const V0: V3 = [1, 0.15, -0.35];
  const f3 = (x: number) => (Math.abs(x) < 5e-4 ? 0 : x).toFixed(3);

  for (const fig of document.querySelectorAll<HTMLElement>('[data-xp="qsand"]')) {
    const cq = fig.querySelector<HTMLCanvasElement>('.c-q')!, cv = fig.querySelector<HTMLCanvasElement>('.c-v')!;
    const out = outputs(fig);
    const halfBtn = fig.querySelector<HTMLButtonElement>('[data-act="half"]')!;
    let al = 120, uaz = 30, uel = 55, half = false, az = 0.6, el = 0.35;
    const Qc = setupCanvas(cq, 1, () => draw()), Vc = setupCanvas(cv, 1, () => draw());

    const axis = (): V3 => { const a = uaz * D2R, e = uel * D2R; return [Math.cos(e) * Math.cos(a), Math.cos(e) * Math.sin(a), -Math.sin(e)]; };
    const quat = (ang: number): Q => { const u = axis(), s = Math.sin(ang / 2); return [Math.cos(ang / 2), u[0] * s, u[1] * s, u[2] * s]; };
    const sandwich = (q: Q, v: V3): V3 => { const r = qmul(qmul(q, [0, v[0], v[1], v[2]]), qconj(q)); return [r[1], r[2], r[3]]; };

    function drawCircle() {
      const P = palette(), { ctx, size } = Qc, W = size.w, H = size.h;
      if (!W) return;
      ctx.clearRect(0, 0, W, H);
      const cx = W / 2, cy = H / 2 + 6, R = Math.min(W, H) * 0.33;
      ctx.strokeStyle = P.strong; ctx.lineWidth = 1; ctx.beginPath(); ctx.moveTo(cx - R * 1.3, cy); ctx.lineTo(cx + R * 1.3, cy); ctx.moveTo(cx, cy + R * 1.3); ctx.lineTo(cx, cy - R * 1.3); ctx.stroke();
      ctx.strokeStyle = P.soft; ctx.beginPath(); ctx.arc(cx, cy, R, 0, Math.PI * 2); ctx.stroke();
      label(ctx, 'scalar part ($1$)', cx + R * 1.3, cy + 14, P.muted, { size: 11, align: 'right' });
      label(ctx, 'along $\\mathbf{u}$', cx + 6, cy - R * 1.3 + 4, P.muted, { size: 11 });
      const phi = (al / 2) * D2R;
      // arc from 1 to q
      ctx.strokeStyle = P.accent; ctx.lineWidth = 1.5; ctx.beginPath(); ctx.arc(cx, cy, R * 0.3, 0, -phi, true); ctx.stroke();
      label(ctx, '$\\alpha/2$', cx + Math.cos(phi / 2) * R * 0.42, cy - Math.sin(phi / 2) * R * 0.42, P.accent, { size: 12, align: 'center' });
      const qx = cx + Math.cos(phi) * R, qy = cy - Math.sin(phi) * R;
      arrow(ctx, cx, cy, qx, qy, P.accent, 2.5, 10);
      label(ctx, '$\\mathbf{q}$', qx + 8, qy - 8, P.accent, { size: 14 });
      // -q
      const mx = cx - Math.cos(phi) * R, my = cy + Math.sin(phi) * R;
      ctx.strokeStyle = P.muted; ctx.lineWidth = 1.5; ctx.beginPath(); ctx.arc(mx, my, 5, 0, Math.PI * 2); ctx.stroke();
      label(ctx, '$-\\mathbf{q}$ (same rotation)', mx + 8, my + 12, P.muted, { size: 11 });
      label(ctx, 'like a complex number, with $\\mathbf{u}$ in the role of $i$', 8, H - 10, P.soft, { size: 11 });
    }

    function drawVec() {
      const P = palette(), { ctx, size } = Vc, W = size.w, H = size.h;
      if (!W) return;
      ctx.clearRect(0, 0, W, H);
      const cam = camera(az, el, Math.min(W, H) * 0.3, W / 2, H / 2 + 8);
      const pr = (v: V3) => cam.project(v);
      const o = pr([0, 0, 0]), u = axis();
      for (const [v, n] of [[[1.4, 0, 0], 'N'], [[0, 1.4, 0], 'E'], [[0, 0, 1.4], 'D']] as [V3, string][]) { const p = pr(v); arrow(ctx, o.x, o.y, p.x, p.y, P.strong, 1, 7); label(ctx, n, p.x + 4, p.y, P.muted, { size: 10 }); }
      const ua = pr([u[0] * 1.6, u[1] * 1.6, u[2] * 1.6]), ub = pr([-u[0] * 1.2, -u[1] * 1.2, -u[2] * 1.2]);
      ctx.strokeStyle = P.fg; ctx.setLineDash([5, 4]); ctx.lineWidth = 1; ctx.beginPath(); ctx.moveTo(ub.x, ub.y); ctx.lineTo(ua.x, ua.y); ctx.stroke(); ctx.setLineDash([]);
      arrow(ctx, o.x, o.y, ua.x, ua.y, P.fg, 1.25, 8); label(ctx, '$\\mathbf{u}$', ua.x + 6, ua.y, P.fg, { size: 14 });
      // path of the rotated vector for angles 0..alpha
      ctx.strokeStyle = P.accent; ctx.globalAlpha = 0.45; ctx.lineWidth = 1.5; ctx.beginPath();
      const steps = Math.max(2, Math.round(al / 3));
      for (let i = 0; i <= steps; i++) { const p = pr(sandwich(quat(((al * i) / steps) * D2R), V0)); i ? ctx.lineTo(p.x, p.y) : ctx.moveTo(p.x, p.y); }
      ctx.stroke(); ctx.globalAlpha = 1;
      const q = quat(al * D2R), vr = sandwich(q, V0);
      const v0p = pr(V0); arrow(ctx, o.x, o.y, v0p.x, v0p.y, P.fg, 2, 10); label(ctx, '$\\mathbf{v}$', v0p.x + 6, v0p.y + 4, P.fg, { size: 14 });
      const vrp = pr(vr); arrow(ctx, o.x, o.y, vrp.x, vrp.y, P.accent, 2.5, 11); label(ctx, "$\\mathbf{v}'$", vrp.x + 6, vrp.y - 6, P.accent, { size: 14 });
      const qv = qmul(q, [0, V0[0], V0[1], V0[2]]);
      if (half) { const hp = pr([qv[1], qv[2], qv[3]]); ctx.setLineDash([4, 4]); arrow(ctx, o.x, o.y, hp.x, hp.y, P.muted, 1.75, 9); ctx.setLineDash([]); label(ctx, 'vector part of $\\mathbf{q}\\otimes\\mathbf{v}$', hp.x + 6, hp.y + 10, P.muted, { size: 11 }); }
      out('q', `[${q.map(f3).join(', ')}]`);
      out('vr', `[0, ${vr.map(f3).join(', ')}]`);
      out('s', `${f3(qv[0])}${Math.abs(qv[0]) > 5e-4 ? ' (not a pure vector)' : ''}`);
    }

    function draw() { drawCircle(); drawVec(); }
    slider(fig, 'al', (v) => `${v}°`, (v) => { al = v; draw(); });
    slider(fig, 'az', (v) => `${v}°`, (v) => { uaz = v; draw(); });
    slider(fig, 'el', (v) => `${v}°`, (v) => { uel = v; draw(); });
    halfBtn.addEventListener('click', () => { half = !half; halfBtn.setAttribute('aria-pressed', String(half)); draw(); });

    let drag: { x: number; y: number; az: number; el: number } | null = null;
    cv.addEventListener('pointerdown', (e) => { drag = { x: e.clientX, y: e.clientY, az, el }; cv.setPointerCapture(e.pointerId); });
    cv.addEventListener('pointermove', (e) => { if (!drag) return; az = drag.az - (e.clientX - drag.x) * 0.01; el = Math.max(-1.4, Math.min(1.4, drag.el + (e.clientY - drag.y) * 0.01)); draw(); });
    cv.addEventListener('pointerup', () => (drag = null));
  }
</script>
