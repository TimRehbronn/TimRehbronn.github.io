---
import M from '../../blog/M.astro';
// Attitude kinematics in 2D (rotation about the vertical only), seen from above with north up and east right.
// The columns of C (body axes) move perpendicular to themselves with speed ω. Repeated first-order steps
// C ← C (I + [ω×]Δt) move each tip straight along the tangent and spiral outwards; exact steps C ← C exp([ω×]Δt)
// follow the unit circle.
---

<figure class="xp wide" data-xp="attode">
  <div class="xp-head"><span class="label fig-title">Integrating the attitude equation step by step</span></div>
  <div class="xp-row two">
    <canvas class="c-main" role="img" aria-label="Top view with north up and east right: the unit circle, the two body axes as arrows from the centre, the velocity of each axis tip along the tangent, and the trail of the computed axis tips, step by step"></canvas>
    <div class="ao-side">
      <p class="ao-title">One step of the tip of <M t={String.raw`\mathbf c_1`} />, magnified (lengths relative to <M t={String.raw`\lVert\mathbf c_1\rVert`} />)</p>
      <canvas class="c-zoom" role="img" aria-label="Magnified view of one step: the straight first-order step along the tangent ends slightly outside the circular arc that the exact step follows"></canvas>
      <div class="ao-eq">
        <div class="ao-blk">
          <span class="ao-cap"><span data-cap="fo">step <M t={String.raw`\mathbf I + [\boldsymbol\omega\times]\Delta t`} /></span><span data-cap="ex" hidden>step <M t={String.raw`\exp([\boldsymbol\omega\times]\Delta t)`} /></span></span>
          <table class="ao-m"><tbody data-m="s"></tbody></table>
        </div>
        <div class="ao-blk hot">
          <span class="ao-cap"><M t={String.raw`\mathbf C_k`} /></span>
          <table class="ao-m"><tbody data-m="c"></tbody></table>
        </div>
        <div class="ao-blk hot">
          <span class="ao-cap"><M t={String.raw`\mathbf C_k^\mathsf T\mathbf C_k`} /> (exact: <M t={String.raw`\mathbf I`} />)</span>
          <table class="ao-m"><tbody data-m="g"></tbody></table>
        </div>
      </div>
      <p class="small muted ao-note">In two dimensions <M t={String.raw`[\boldsymbol\omega\times]`} /> shrinks to <M t={String.raw`\begin{bmatrix} 0 & -\omega \\ \omega & 0 \end{bmatrix}`} />, so <M t={String.raw`\dot{\mathbf C} = \mathbf C \begin{bmatrix} 0 & -\omega \\ \omega & 0 \end{bmatrix}`} />, column by column <M t={String.raw`\dot{\mathbf c}_1 = \omega\,\mathbf c_2`} /> and <M t={String.raw`\dot{\mathbf c}_2 = -\omega\,\mathbf c_1`} />: each axis moves like itself turned by <M t={String.raw`90^\circ`} /> (clockwise from above), times <M t={String.raw`\omega`} />.</p>
      <p class="small muted ao-note" data-note="fo">First-order step: new axis = old axis + <M t={String.raw`\omega\Delta t`} /> × (old axis turned by <M t={String.raw`90^\circ`} />). A straight step along the tangent: each step lengthens the axis by the factor <M t={String.raw`\sqrt{1 + (\omega\Delta t)^2}`} />.</p>
      <p class="small muted ao-note" data-note="ex" hidden>Exact step: new axis = <M t={String.raw`\cos(\omega\Delta t)`} /> × old axis + <M t={String.raw`\sin(\omega\Delta t)`} /> × (old axis turned by <M t={String.raw`90^\circ`} />). The tip moves along the arc and the length stays 1.</p>
    </div>
  </div>
  <ul class="xp-legend">
    <li class="c-fg"><i></i><span>exact body axes <M t={String.raw`\mathbf c_1, \mathbf c_2`} /> (columns of <M t={String.raw`\mathbf C`} />)</span></li>
    <li class="c-muted"><i></i><span>velocity of each tip times the step, <M t={String.raw`\dot{\mathbf c}_i\,\Delta t`} /></span></li>
    <li class="c-accent"><i></i><span>computed axes <M t={String.raw`\mathbf C_k`} /> and the path of their tips (dots: steps)</span></li>
  </ul>
  <div class="xp-controls">
    <label class="xp-ctl"><span><span>Angle per step <M t={String.raw`\omega\Delta t`} /></span><output for="deg"></output></span><input type="range" name="deg" min="2" max="45" step="1" value="12" /></label>
  </div>
  <div class="xp-btns">
    <button class="btn" type="button" data-mode="fo" aria-pressed="true">first-order step</button>
    <button class="btn" type="button" data-mode="ex" aria-pressed="false">exact step</button>
    <span class="ao-gap"></span>
    <button class="btn" type="button" data-act="step">one step</button>
    <button class="btn" type="button" data-act="play" aria-pressed="false">play</button>
    <button class="btn" type="button" data-act="reset">reset</button>
  </div>
  <p class="xp-readout" aria-live="polite">
    <span>step <M t="k" /> = <b data-o="k"></b></span>
    <span>angle turned <M t={String.raw`k\,\omega\Delta t`} /> = <b data-o="ang"></b></span>
    <span>direction of computed <M t={String.raw`\mathbf c_1`} /> = <b class="hot" data-o="dir"></b></span>
    <span>length <M t={String.raw`\lVert\mathbf c_1\rVert`} /> = <b class="hot" data-o="len"></b> (exact: 1)</span>
    <span data-o="status"></span>
  </p>
  <figcaption><slot /></figcaption>
</figure>

<style>
  .ao-side { min-width: 0; overflow-x: auto; }
  .ao-title { margin: 0 0 0.3rem; font-size: 0.8rem; color: var(--fg-soft); text-align: left; }
  .ao-eq { display: flex; align-items: flex-end; gap: 0.6rem 1.2rem; margin: 0.7rem 0 0.6rem; flex-wrap: wrap; }
  .ao-blk { display: flex; flex-direction: column; align-items: center; gap: 0.2rem; }
  .ao-cap { font-size: 0.8rem; color: var(--fg-soft); }
  .ao-blk.hot .ao-cap { color: var(--accent); }
  .ao-m { border-collapse: collapse; margin: 0; font-variant-numeric: tabular-nums; font-size: 0.85rem; }
  .ao-m :global(tr), .ao-m tbody { border: 0; }
  .ao-m :global(td) { border: 0; padding: 0.1rem 0.45rem; text-align: right; color: var(--fg); min-width: 3.4rem; }
  .ao-blk.hot .ao-m :global(td) { color: var(--accent); }
  .ao-m :global(tr td:first-child) { border-left: 1px solid var(--border-strong); }
  .ao-m :global(tr td:last-child) { border-right: 1px solid var(--border-strong); }
  .ao-note { text-align: left; margin: 0 0 0.5rem; }
  .ao-gap { flex: 0 0 0.6rem; }
</style>

<script>
  import { palette, setupCanvas, animate, label, slider, arrow, outputs, reducedMotion, lazyInit } from '../../../lib/explainer';

  type M2 = [number, number, number, number];          // [[a, b], [c, d]] row by row; columns = body axes in (north, east)
  type V2 = [number, number];                          // (north, east)
  const D2R = Math.PI / 180;
  const VIEW = 2.2;                                    // half extent of the main view, in units of the axis length
  const FIT = 2.1;                                     // stop before an axis tip would leave the view
  const I2: M2 = [1, 0, 0, 1];
  const mul = (A: M2, B: M2): M2 => [A[0] * B[0] + A[1] * B[2], A[0] * B[1] + A[1] * B[3], A[2] * B[0] + A[3] * B[2], A[2] * B[1] + A[3] * B[3]];
  const col = (C: M2, i: number): V2 => (i ? [C[1], C[3]] : [C[0], C[2]]);
  const turn = (v: V2): V2 => [-v[1], v[0]];           // +90°: clockwise seen from above (north -> east)
  const rot = (a: number): M2 => [Math.cos(a), -Math.sin(a), Math.sin(a), Math.cos(a)];
  const first = (a: number): M2 => [1, -a, a, 1];

  lazyInit('[data-xp="attode"]', (fig) => {
    const cm = fig.querySelector<HTMLCanvasElement>('.c-main')!, cz = fig.querySelector<HTMLCanvasElement>('.c-zoom')!;
    const out = outputs(fig);
    const tb = (n: string) => fig.querySelector<HTMLElement>(`[data-m="${n}"]`)!;
    const tS = tb('s'), tC = tb('c'), tG = tb('g');
    const playBtn = fig.querySelector<HTMLButtonElement>('[data-act="play"]')!;
    let deg = 12, exact = false, k = 0, u = 0, playing = false, stepping = false, endReason = 'rev';
    let Cs: M2[] = [I2];
    const h = () => deg * D2R;
    const stepM = (a: number) => (exact ? rot(a) : first(a));
    const kmax = () => Cs.length - 1;

    function compute() {
      const S = stepM(h()), N = Math.floor((2 * Math.PI) / h() + 1e-6);
      Cs = [I2]; endReason = 'rev';
      for (let j = 0; j < N; j++) {
        const nx = mul(Cs[j], S);
        if (Math.hypot(nx[0], nx[2]) > FIT) { endReason = 'out'; break; }
        Cs.push(nx);
      }
    }
    /** C shown on screen: C_k, or part of the way to C_{k+1} during an animated step */
    function shown(): M2 {
      const Ck = Cs[k];
      if (u <= 0 || k >= kmax()) return Ck;
      if (exact) return mul(Ck, rot(u * h()));
      const Cn = Cs[k + 1];
      return Ck.map((v, i) => v + u * (Cn[i] - v)) as M2;
    }

    const A = setupCanvas(cm, 1, () => drawMain());
    const Z = setupCanvas(cz, (w) => Math.min(w * 0.5, 230), () => drawZoom());

    /** label with a dot over its first letter (canvas math has no \dot) */
    function dotLabel(ctx: CanvasRenderingContext2D, text: string, x: number, y: number, color: string, size: number, align: CanvasTextAlign) {
      const w = label(ctx, text, x, y, color, { size, align });
      const x0 = align === 'center' ? x - w / 2 : align === 'right' ? x - w : x;
      ctx.fillStyle = color; ctx.beginPath(); ctx.arc(x0 + size * 0.33, y - size * 0.68, 1.4, 0, Math.PI * 2); ctx.fill();
    }

    function drawMain() {
      const P = palette(), { ctx, size } = A, W = size.w, H = size.h;
      if (!W) return;
      ctx.clearRect(0, 0, W, H);
      const cx = W / 2, cy = H / 2, U = Math.min(W, H) / (2 * VIEW);
      const X = (v: V2) => cx + v[1] * U, Y = (v: V2) => cy - v[0] * U;
      // north and east axes
      ctx.strokeStyle = P.border; ctx.lineWidth = 1;
      ctx.beginPath(); ctx.moveTo(0, cy + 0.5); ctx.lineTo(W, cy + 0.5); ctx.moveTo(cx + 0.5, 0); ctx.lineTo(cx + 0.5, H); ctx.stroke();
      const tw = label(ctx, 'seen from above: north up, east right', 4, 10, P.muted, { size: 11 });
      // unit circle
      ctx.strokeStyle = P.strong; ctx.lineWidth = 1.5;
      ctx.beginPath(); ctx.arc(cx, cy, U, 0, Math.PI * 2); ctx.stroke();

      const a = h(), C = shown();
      // trail of the computed tips (straight segments for first order, arcs for the exact step)
      const dotR = deg < 6 ? 1.5 : 2.5;
      for (let i = 0; i < 2; i++) {
        ctx.strokeStyle = P.accent; ctx.lineWidth = 1.25; ctx.globalAlpha = 0.75;
        ctx.beginPath();
        let p = col(Cs[0], i); ctx.moveTo(X(p), Y(p));
        for (let j = 0; j < k; j++) {
          if (exact) for (let s = 1; s <= 8; s++) { p = col(mul(Cs[j], rot((s / 8) * a)), i); ctx.lineTo(X(p), Y(p)); }
          else { p = col(Cs[j + 1], i); ctx.lineTo(X(p), Y(p)); }
        }
        if (u > 0 && k < kmax()) {
          if (exact) for (let s = 1; s <= 8; s++) { p = col(mul(Cs[k], rot((s / 8) * u * a)), i); ctx.lineTo(X(p), Y(p)); }
          else { p = col(C, i); ctx.lineTo(X(p), Y(p)); }
        }
        ctx.stroke(); ctx.globalAlpha = 1;
        ctx.fillStyle = P.accent;
        for (let j = 0; j <= k; j++) { const q = col(Cs[j], i); ctx.beginPath(); ctx.arc(X(q), Y(q), dotR, 0, Math.PI * 2); ctx.fill(); }
      }
      // velocity times the step, at the tips of C_k: the axis turned by 90° times ωΔt
      for (let i = 0; i < 2; i++) {
        const c = col(Cs[k], i), v = turn(c), e: V2 = [c[0] + a * v[0], c[1] + a * v[1]];
        arrow(ctx, X(c), Y(c), X(e), Y(e), P.muted, 2, 8);
        const len = a * Math.hypot(c[0], c[1]) * U;
        if (len > 22) {
          // beside the middle of the arrow (outwards), or else beyond its head; skip if neither fits
          const m: V2 = [(c[0] + e[0]) / 2, (c[1] + e[1]) / 2], n = Math.hypot(m[0], m[1]) || 1, vl = Math.hypot(v[0], v[1]) || 1;
          const cand: [number, number][] = [[X(m) + (m[1] / n) * 26, Y(m) - (m[0] / n) * 16], [X(e) + (v[1] / vl) * 26, Y(e) - (v[0] / vl) * 16]];
          const fit = cand.find(([x, y]) => x > 24 && x < W - 24 && y < H - 10 && (y > 26 || (y > 12 && x - 22 > tw + 10)));
          if (fit) dotLabel(ctx, `$\\b{c}_${i + 1}\\Delta t$`, fit[0], fit[1], P.soft, 12, 'center');
        }
      }
      // exact axes (white): heading ψ = (k + u) ωΔt
      const psi = (k + u) * a, ex: V2[] = [[Math.cos(psi), Math.sin(psi)], [-Math.sin(psi), Math.cos(psi)]];
      for (const c of ex) arrow(ctx, cx, cy, X(c), Y(c), P.fg, 2, 9);
      // computed axes (orange)
      for (let i = 0; i < 2; i++) {
        const c = col(C, i), n = Math.hypot(c[0], c[1]) || 1;
        arrow(ctx, cx, cy, X(c), Y(c), P.accent, 2.5, 10);
        // label beside the shaft, on the side that trails the motion (counter-clockwise of the axis)
        const t = 0.62, b: V2 = [c[0] * t, c[1] * t], off = 13;
        label(ctx, `$\\b{c}_${i + 1}$`, X(b) - (c[0] / n) * off, Y(b) - (c[1] / n) * off, P.accent, { size: 14, align: 'center' });
      }
    }

    function drawZoom() {
      const P = palette(), { ctx, size } = Z, W = size.w, H = size.h;
      if (!W) return;
      ctx.clearRect(0, 0, W, H);
      ctx.strokeStyle = P.border; ctx.lineWidth = 1; ctx.strokeRect(0.5, 0.5, W - 1, H - 1);
      const a = h(), sc = (W * 0.55) / a;                 // px per unit radius: the straight step spans 55% of the width
      const x0 = W * 0.12, y0 = H * 0.32;
      // local coordinates: tangent along +x, outward radial direction up; circle of radius 1 centred at (0, -1)
      const S = (t: number, r: number) => [x0 + t * sc, y0 - r * sc];
      const onC = (phi: number) => S(Math.sin(phi), Math.cos(phi) - 1);
      // exact arc
      ctx.strokeStyle = P.fg; ctx.lineWidth = 1.5; ctx.beginPath();
      for (let j = 0; j <= 60; j++) { const q = onC(-0.15 * a + (j / 60) * 1.4 * a); j ? ctx.lineTo(q[0], q[1]) : ctx.moveTo(q[0], q[1]); }
      ctx.stroke();
      const R = onC(a), Q = S(a, 0), P0 = S(0, 0);
      const lc = onC(0.5 * a);
      label(ctx, 'circle', lc[0], lc[1] + 14, P.soft, { size: 11, align: 'center' });
      if (exact) {
        arrow(ctx, P0[0], P0[1], Q[0], Q[1], P.muted, 1.5, 7);
        dotLabel(ctx, '$\\b{c}_1\\Delta t$', (P0[0] + Q[0]) / 2, y0 - 14, P.soft, 12, 'center');
        ctx.strokeStyle = P.accent; ctx.lineWidth = 2.5; ctx.beginPath();
        for (let j = 0; j <= 40; j++) { const q = onC((j / 40) * a); j ? ctx.lineTo(q[0], q[1]) : ctx.moveTo(q[0], q[1]); }
        ctx.stroke();
        ctx.fillStyle = P.accent; ctx.beginPath(); ctx.arc(R[0], R[1], 4, 0, Math.PI * 2); ctx.fill();
        label(ctx, 'exact step: on the arc, no overshoot', W / 2, H - 14, P.accent, { size: 11, align: 'center' });
      } else {
        ctx.fillStyle = P.fg; ctx.beginPath(); ctx.arc(R[0], R[1], 3, 0, Math.PI * 2); ctx.fill();
        arrow(ctx, P0[0], P0[1], Q[0], Q[1], P.accent, 2.5, 9);
        label(ctx, 'straight step $\\omega\\Delta t$', (P0[0] + Q[0]) / 2, y0 - 14, P.accent, { size: 11, align: 'center' });
        // radial overshoot: from the circle (along the radius through Q) out to Q
        const rq = Math.hypot(a, 1), phiQ = Math.atan2(a, 1), Qc = onC(phiQ);
        ctx.strokeStyle = P.accent; ctx.lineWidth = 1; ctx.setLineDash([2, 2]);
        const dir = [Q[0] - Qc[0], Q[1] - Qc[1]], dl = Math.hypot(dir[0], dir[1]) || 1;
        ctx.beginPath(); ctx.moveTo(Qc[0], Qc[1]); ctx.lineTo(Q[0] + (dir[0] / dl) * 4, Q[1] + (dir[1] / dl) * 4); ctx.stroke(); ctx.setLineDash([]);
        ctx.fillStyle = P.accent; ctx.beginPath(); ctx.arc(Qc[0], Qc[1], 2, 0, Math.PI * 2); ctx.fill();
        const gap = rq - 1;
        label(ctx, `overshoot ${gap.toFixed(4)}`, Q[0] + 10, Q[1] + 2, P.accent, { size: 11 });
        label(ctx, '$\\approx(\\omega\\Delta t)^2/2$', Q[0] + 10, Q[1] + 17, P.accent, { size: 11 });
        label(ctx, 'exact step ends on the circle', W / 2, H - 14, P.soft, { size: 11, align: 'center' });
      }
      ctx.fillStyle = P.fg; ctx.beginPath(); ctx.arc(P0[0], P0[1], 3.5, 0, Math.PI * 2); ctx.fill();
      label(ctx, 'tip', P0[0], P0[1] + 15, P.soft, { size: 11, align: 'center' });
    }

    const f = (v: number) => (Math.abs(v) < 5e-4 ? '0.000' : v.toFixed(3));
    const mat = (M: M2) => `<tr><td>${f(M[0])}</td><td>${f(M[1])}</td></tr><tr><td>${f(M[2])}</td><td>${f(M[3])}</td></tr>`;
    function panel() {
      fig.querySelectorAll<HTMLElement>('[data-note], [data-cap]').forEach((n) => (n.hidden = (n.dataset.note ?? n.dataset.cap) !== (exact ? 'ex' : 'fo')));
      const Ck = Cs[k];
      tS.innerHTML = mat(stepM(h()));
      tC.innerHTML = mat(Ck);
      const G: M2 = [Ck[0] * Ck[0] + Ck[2] * Ck[2], Ck[0] * Ck[1] + Ck[2] * Ck[3], 0, Ck[1] * Ck[1] + Ck[3] * Ck[3]];
      G[2] = G[1];
      tG.innerHTML = mat(G);
      out('k', String(k));
      out('ang', `${(k * deg).toFixed(0)}°`);
      const d = (Math.atan2(Ck[2], Ck[0]) / D2R + 360) % 360;
      out('dir', `${d.toFixed(1)}° from north`);
      out('len', Math.hypot(Ck[0], Ck[2]).toFixed(3));
      out('status', k < kmax() ? '' : endReason === 'out' ? '(stopped: the next step would leave the view)' : '(one full revolution)');
    }
    function draw() { drawMain(); drawZoom(); panel(); }

    const setPlaying = (p: boolean) => { playing = p; playBtn.textContent = p ? 'pause' : 'play'; playBtn.setAttribute('aria-pressed', String(p)); if (p) anim.kick(); };
    const dur = () => Math.max(0.05, Math.min(0.4, 8 / (360 / deg)));     // seconds per step: one revolution in about 8 s
    const anim = animate(fig, (dt) => {
      if (k >= kmax()) { stepping = false; setPlaying(false); u = 0; draw(); return; }
      u += dt / dur();
      if (u >= 1) {
        u = 0; k++;
        if (!playing) stepping = false;
        if (k >= kmax()) { stepping = false; setPlaying(false); }
      }
      draw();
    }, () => (playing || stepping) && !reducedMotion());

    slider(fig, 'deg', (v) => `${v}°`, (v) => {
      const ang = k * deg;
      deg = v; compute();
      k = Math.min(kmax(), Math.round(ang / deg)); u = 0; stepping = false;
      draw();
    });
    const mb = fig.querySelectorAll<HTMLButtonElement>('[data-mode]');
    mb.forEach((b) => b.addEventListener('click', () => {
      exact = b.dataset.mode === 'ex';
      mb.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      compute(); k = Math.min(k, kmax()); u = 0; stepping = false;
      draw();
    }));
    fig.querySelector('[data-act="step"]')!.addEventListener('click', () => {
      if (playing) setPlaying(false);
      if (stepping || k >= kmax()) return;
      if (reducedMotion()) { k++; draw(); return; }
      stepping = true; u = 0; anim.kick();
    });
    playBtn.addEventListener('click', () => {
      if (k >= kmax() && !playing) { k = 0; u = 0; }
      if (reducedMotion()) { k = kmax(); u = 0; draw(); return; }
      setPlaying(!playing);
      draw();
    });
    fig.querySelector('[data-act="reset"]')!.addEventListener('click', () => {
      setPlaying(false); stepping = false; k = 0; u = 0; draw();
    });

    k = Math.min(kmax(), Math.round(180 / deg));     // start half a turn in, so the drift is already visible
    draw();
  });
</script>
