---
import M from '../../blog/M.astro';
// Planar strapdown navigation: a vehicle drives a route; the INS integrates one gyro and two accelerometers.
---

<figure class="xp wide" data-xp="s2d">
  <div class="xp-head"><span class="label fig-title">Strapdown navigation in the plane</span></div>
  <canvas role="img" aria-label="Top view of a vehicle route with the true path and the path computed by the inertial navigation system, plus the three sensor signals"></canvas>
  <ul class="xp-legend">
    <li class="c-fg"><i></i><span>true path</span></li>
    <li class="c-accent"><i></i><span>strapdown solution</span></li>
  </ul>
  <div class="xp-controls">
    <label class="xp-ctl"><span><span>Gyro bias <M t={String.raw`\varepsilon`} /></span><output for="gb"></output></span><input type="range" name="gb" min="0" max="0.5" step="0.01" value="0.1" /></label>
    <label class="xp-ctl"><span><span>Accelerometer bias <M t={String.raw`b`} /></span><output for="ab"></output></span><input type="range" name="ab" min="0" max="20" step="0.5" value="0" /></label>
    <label class="xp-ctl"><span><span>Initial heading error <M t={String.raw`\delta\psi_0`} /></span><output for="h0"></output></span><input type="range" name="h0" min="-10" max="10" step="0.5" value="0" /></label>
    <label class="xp-ctl"><span><span>Sensor noise (MEMS-like)</span><output for="nz"></output></span><input type="range" name="nz" min="0" max="2" step="0.1" value="0" /></label>
  </div>
  <div class="xp-btns">
    <button class="btn btn-primary" type="button" data-act="play">Pause</button>
    <button class="btn" type="button" data-act="reset">Restart</button>
  </div>
  <p class="xp-readout" aria-live="polite"><span><M t={String.raw`t`} /> = <b data-o="t"></b> / <span data-o="T"></span></span><span>heading error <M t={String.raw`\delta\psi`} /> = <b data-o="h"></b></span><span>position error <b class="hot" data-o="e"></b></span></p>
  <figcaption><slot /></figcaption>
</figure>

<script>
  import { palette, setupCanvas, animate, rng, axes, series, label, slider, fmtLen, reducedMotion, outputs, lazyInit } from '../../../lib/explainer';

  const G = 9.80665, DT = 0.01, D2R = Math.PI / 180;
  // route: [duration s, longitudinal acceleration m/s², yaw rate °/s]
  const ROUTE: [number, number, number][] = [
    [3, 0, 0], [8, 1, 0], [8, 0, 0], [6, 0, 15], [10, 0, 0], [12, 0, -15], [6, 0, 0], [6, 0, 15], [8, 0, 0], [8, -1, 0], [5, 0, 0],
  ];
  const T = ROUTE.reduce((s, r) => s + r[0], 0), N = Math.round(T / DT) + 1;
  const profile = (t: number) => { let s = 0; for (const r of ROUTE) { if (t < s + r[0]) return r; s += r[0]; } return [0, 0, 0] as [number, number, number]; };

  // truth and ideal sensor signals
  const t = new Float64Array(N), tn = new Float64Array(N), te = new Float64Array(N), wz = new Float64Array(N), fx = new Float64Array(N), fy = new Float64Array(N), psiT = new Float64Array(N);
  {
    let n = 0, e = 0, v = 0, psi = 0;
    for (let k = 0; k < N; k++) {
      const [, a, w] = profile(k * DT);
      t[k] = k * DT; tn[k] = n; te[k] = e; psiT[k] = psi;
      wz[k] = w * D2R; fx[k] = a; fy[k] = v * w * D2R; // centripetal acceleration v·ω appears on the lateral axis
      n += v * Math.cos(psi) * DT; e += v * Math.sin(psi) * DT;
      v += a * DT; psi += w * D2R * DT;
    }
  }

  lazyInit('[data-xp="s2d"]', (fig) => {
    const canvas = fig.querySelector('canvas')!;
    const out = outputs(fig);
    const playBtn = fig.querySelector<HTMLButtonElement>('[data-act="play"]')!;
    const inN = new Float64Array(N), inE = new Float64Array(N), psiI = new Float64Array(N);
    let gb = 0, ab = 0, h0 = 0, nz = 0, now = reducedMotion() ? T : 0, running = !reducedMotion();

    function simulate() {
      const r = rng(3);
      let n = 0, e = 0, vn = 0, ve = 0, psi = h0 * D2R;
      const sg = nz * 0.15 * D2R, sa = nz * 0.02;            // per-sample noise at 100 Hz
      for (let k = 0; k < N; k++) {
        inN[k] = n; inE[k] = e; psiI[k] = psi;
        const w = wz[k] + gb * D2R + sg * r.gauss();
        const f1 = fx[k] + ab * 1e-3 * G + sa * r.gauss(), f2 = fy[k] + sa * r.gauss();
        // rotate the specific force from body to navigation axes with the *computed* heading
        const c = Math.cos(psi), s = Math.sin(psi);
        const an = c * f1 - s * f2, ae = s * f1 + c * f2;
        n += vn * DT; e += ve * DT; vn += an * DT; ve += ae * DT; psi += w * DT;
      }
    }

    const { ctx, size } = setupCanvas(canvas, (w) => (w < 560 ? w * 1.45 : Math.max(380, w * 0.56)), draw);

    function draw() {
      const P = palette(), W = size.w, H = size.h;
      if (!W) return;
      ctx.clearRect(0, 0, W, H);
      const k = Math.min(N - 1, Math.round(now / DT));
      const narrow = W < 560;
      const map = narrow ? { x: 0, y: 0, w: W, h: H * 0.56 } : { x: 0, y: 0, w: W * 0.58, h: H };
      const strip = narrow ? { x: 46, y: map.h + 16, w: W - 56, h: H - map.h - 16 } : { x: map.w + 52, y: 6, w: W - map.w - 60, h: H - 12 };

      // fit map to truth (and the INS path, within limits)
      let n0 = Infinity, n1 = -Infinity, e0 = Infinity, e1 = -Infinity;
      for (let i = 0; i < N; i += 10) { n0 = Math.min(n0, tn[i]); n1 = Math.max(n1, tn[i]); e0 = Math.min(e0, te[i]); e1 = Math.max(e1, te[i]); }
      const span0 = Math.max(n1 - n0, e1 - e0);
      for (let i = 0; i < N; i += 10) {
        n0 = Math.min(n0, Math.max(inN[i], tn[i] - span0)); n1 = Math.max(n1, Math.min(inN[i], tn[i] + span0));
        e0 = Math.min(e0, Math.max(inE[i], te[i] - span0)); e1 = Math.max(e1, Math.min(inE[i], te[i] + span0));
      }
      const pad = 26, sc = Math.min((map.w - 2 * pad) / (e1 - e0), (map.h - 2 * pad) / (n1 - n0));
      const ox = map.x + map.w / 2 - ((e0 + e1) / 2) * sc, oy = map.y + map.h / 2 + ((n0 + n1) / 2) * sc;
      const X = (e: number) => ox + e * sc, Y = (n: number) => oy - n * sc;

      // grid
      const gstep = [10, 20, 50, 100, 200, 500, 1000].find((g) => g * sc > 40) ?? 1000;
      ctx.strokeStyle = P.border; ctx.lineWidth = 1;
      for (let e = Math.ceil(e0 / gstep) * gstep - gstep * 3; e <= e1 + gstep * 3; e += gstep) { const x = Math.round(X(e)) + 0.5; if (x < map.x || x > map.x + map.w) continue; ctx.beginPath(); ctx.moveTo(x, map.y); ctx.lineTo(x, map.y + map.h); ctx.stroke(); }
      for (let n = Math.ceil(n0 / gstep) * gstep - gstep * 3; n <= n1 + gstep * 3; n += gstep) { const y = Math.round(Y(n)) + 0.5; if (y < map.y || y > map.y + map.h) continue; ctx.beginPath(); ctx.moveTo(map.x, y); ctx.lineTo(map.x + map.w, y); ctx.stroke(); }
      label(ctx, `grid ${gstep} m · N ↑`, map.x + 6, map.y + 10, P.muted, { size: 10 });

      const path = (an: Float64Array, ae: Float64Array, col: string, w: number, dash: number[] = []) => {
        ctx.save(); ctx.beginPath(); ctx.rect(map.x, map.y, map.w, map.h); ctx.clip();
        ctx.strokeStyle = col; ctx.lineWidth = w; ctx.setLineDash(dash); ctx.beginPath();
        for (let i = 0; i <= k; i += 5) i ? ctx.lineTo(X(ae[i]), Y(an[i])) : ctx.moveTo(X(ae[i]), Y(an[i]));
        ctx.lineTo(X(ae[k]), Y(an[k])); ctx.stroke(); ctx.restore();
      };
      // faint full route
      ctx.save(); ctx.globalAlpha = 0.25; ctx.strokeStyle = P.fg; ctx.lineWidth = 1; ctx.beginPath();
      for (let i = 0; i < N; i += 10) i ? ctx.lineTo(X(te[i]), Y(tn[i])) : ctx.moveTo(X(te[i]), Y(tn[i])); ctx.stroke(); ctx.restore();
      path(tn, te, P.fg, 2);
      path(inN, inE, P.accent, 2);

      const vehicle = (n: number, e: number, psi: number, col: string, fill: boolean) => {
        const x = X(e), y = Y(n), L = 11, c = Math.sin(psi), s = -Math.cos(psi); // heading direction on screen
        ctx.beginPath();
        ctx.moveTo(x + c * L, y + s * L);
        ctx.lineTo(x - c * L * 0.6 - s * L * 0.55, y - s * L * 0.6 + c * L * 0.55);
        ctx.lineTo(x - c * L * 0.6 + s * L * 0.55, y - s * L * 0.6 - c * L * 0.55);
        ctx.closePath();
        ctx.lineWidth = 1.5; ctx.strokeStyle = col; ctx.fillStyle = col;
        fill ? ctx.fill() : ctx.stroke();
      };
      vehicle(inN[k], inE[k], psiI[k], P.accent, false);
      vehicle(tn[k], te[k], psiT[k], P.fg, true);

      // sensor strips
      const gap = 22, hh = (strip.h - 2 * gap - 14) / 3;
      const rows: [string, Float64Array, number, number][] = [
        ['gyro $\\omega$ [°/s]', wz, -20, 20],
        ['accel $f_x^b$ [m/s²]', fx, -2, 2],
        ['accel $f_y^b$ [m/s²]', fy, -3, 3],
      ];
      rows.forEach(([name, data, lo, hi], i) => {
        const b = { x: strip.x, y: strip.y + i * (hh + gap), w: strip.w, h: hh };
        const A = axes(ctx, P, b, [0, T], [lo, hi], { ylabel: name, yticks: 2, xticks: 4, xfmt: (v) => (i === 2 ? `${v}s` : ''), yfmt: (v) => v.toFixed(0), zeroLine: true });
        const scaleV = name.startsWith('gyro') ? 1 / D2R : 1;
        const ys = scaleV === 1 ? data : data.map((v) => v * scaleV);
        series(ctx, b, t, ys, A.sx, A.sy, P.soft, 1.25, [], N);
        const x = A.sx(now); ctx.strokeStyle = P.accent; ctx.beginPath(); ctx.moveTo(x + 0.5, b.y); ctx.lineTo(x + 0.5, b.y + b.h); ctx.stroke();
      });

      const err = Math.hypot(inN[k] - tn[k], inE[k] - te[k]);
      const dpsi = ((psiI[k] - psiT[k]) / D2R + 540) % 360 - 180;
      out('t', `${now.toFixed(1)} s`); out('T', `${T} s`); out('h', `${dpsi.toFixed(2)}°`); out('e', fmtLen(err));
    }

    const anim = animate(fig, (dt) => {
      now += dt * 4;
      if (now >= T) { now = T; running = false; playBtn.textContent = 'Play'; }
      draw();
    }, () => running);
    const restart = () => { now = 0; running = true; playBtn.textContent = 'Pause'; anim.kick(); draw(); };
    const upd = () => { simulate(); draw(); };
    slider(fig, 'gb', (v) => `${v.toFixed(2)} °/s`, (v) => { gb = v; upd(); });
    slider(fig, 'ab', (v) => `${v.toFixed(1)} mg`, (v) => { ab = v; upd(); });
    slider(fig, 'h0', (v) => `${v.toFixed(1)}°`, (v) => { h0 = v; upd(); });
    slider(fig, 'nz', (v) => (v === 0 ? 'off' : `×${v.toFixed(1)}`), (v) => { nz = v; upd(); });
    playBtn.addEventListener('click', () => { if (now >= T) return restart(); running = !running; playBtn.textContent = running ? 'Pause' : 'Play'; anim.kick(); });
    fig.querySelector('[data-act="reset"]')!.addEventListener('click', restart);
    if (!running) playBtn.textContent = 'Play';
  });
</script>
