---
import M from '../../blog/M.astro';
// Random constant, random walk and first-order Gauss-Markov bias: many realizations with the theoretical spread.
---

<figure class="xp wide" data-xp="biasmodels">
  <div class="xp-head"><span class="label fig-title">Three models for a wandering bias</span></div>
  <div class="xp-btns">
    <button class="btn" type="button" data-mode="0" aria-pressed="false">Random constant</button>
    <button class="btn" type="button" data-mode="1" aria-pressed="false">Random walk</button>
    <button class="btn" type="button" data-mode="2" aria-pressed="true">Gauss–Markov</button>
    <button class="btn" type="button" data-act="seed">New realizations</button>
  </div>
  <canvas role="img" aria-label="Many realizations of the selected bias model over two hours, one highlighted, with the theoretical plus-minus one standard deviation envelope"></canvas>
  <ul class="xp-legend">
    <li class="c-muted"><i></i><span>40 of 300 realizations</span></li>
    <li class="c-accent"><i></i><span>one realization</span></li>
    <li class="c-fg dash"><i></i><span>theory: <M t={String.raw`\pm\sigma(t)`} /></span></li>
    <li class="c-muted dash"><i></i><span>Gauss–Markov only: random walk with <M t={String.raw`K = \sigma_b\sqrt{2/\tau_c}`} /></span></li>
  </ul>
  <div class="xp-controls">
    <label class="xp-ctl"><span><span>Turn-on spread <M t={String.raw`\sigma_{b,0}\ [{}^\circ/\mathrm h]`} /></span><output for="s0"></output></span><input type="range" name="s0" min="0.2" max="4" step="0.1" value="2" /></label>
    <label class="xp-ctl"><span><span>Random walk <M t={String.raw`K\ [{}^\circ/\mathrm h/\sqrt{\mathrm h}]`} /></span><output for="k"></output></span><input type="range" name="k" min="0.2" max="4" step="0.1" value="2" /></label>
    <label class="xp-ctl"><span><span>Long-term spread <M t={String.raw`\sigma_b\ [{}^\circ/\mathrm h]`} /></span><output for="sb"></output></span><input type="range" name="sb" min="0.2" max="4" step="0.1" value="2" /></label>
    <label class="xp-ctl"><span><span>Correlation time <M t={String.raw`\tau_c\ [\mathrm{min}]`} /></span><output for="tc"></output></span><input type="range" name="tc" min="0" max="2.3" step="0.02" value="1.18" /></label>
  </div>
  <p class="xp-readout" aria-live="polite"><span>spread at <M t={String.raw`t = 120\,\mathrm{min}`} />: measured <b class="hot" data-o="emp"></b>, theory <b data-o="th"></b></span><span data-o="note"></span></p>
  <figcaption><slot /></figcaption>
</figure>

<script>
  import { palette, setupCanvas, label, slider, axes, series, rng, outputs } from '../../../lib/explainer';

  const T = 120, DT = 0.5, NS = Math.round(T / DT) + 1, RUNS = 300, SHOW = 40;  // minutes

  for (const fig of document.querySelectorAll<HTMLElement>('[data-xp="biasmodels"]')) {
    const canvas = fig.querySelector('canvas')!;
    const out = outputs(fig);
    let mode = 2, seed = 3, s0 = 2, K = 2, sb = 2, tc = 15;
    const t = new Float64Array(NS); for (let k = 0; k < NS; k++) t[k] = k * DT;
    let paths: Float64Array[] = [];
    const finals = new Float64Array(RUNS);
    const inputs = {
      s0: fig.querySelector<HTMLInputElement>('input[name="s0"]')!, k: fig.querySelector<HTMLInputElement>('input[name="k"]')!,
      sb: fig.querySelector<HTMLInputElement>('input[name="sb"]')!, tc: fig.querySelector<HTMLInputElement>('input[name="tc"]')!,
    };

    function simulate() {
      const r = rng(seed), phi = Math.exp(-DT / tc), q = sb * Math.sqrt(1 - phi * phi), qrw = K * Math.sqrt(DT / 60);
      paths = [];
      for (let j = 0; j < RUNS; j++) {
        const keep = j < SHOW ? new Float64Array(NS) : null;
        let b = mode === 0 ? s0 * r.gauss() : 0;
        for (let k = 0; k < NS; k++) {
          if (keep) keep[k] = b;
          if (k === NS - 1) break;
          if (mode === 1) b += qrw * r.gauss();
          else if (mode === 2) b = phi * b + q * r.gauss();
        }
        finals[j] = b;
        if (keep) paths.push(keep);
      }
    }
    // theoretical standard deviation; time in minutes, K per square root of an hour
    const sigma = (tt: number) => (mode === 0 ? s0 : mode === 1 ? K * Math.sqrt(tt / 60) : sb * Math.sqrt(1 - Math.exp((-2 * tt) / tc)));

    const { ctx, size } = setupCanvas(canvas, (w) => Math.max(300, w * 0.42), draw);

    function draw() {
      const P = palette(), W = size.w, H = size.h;
      if (!W || !paths.length) return;
      ctx.clearRect(0, 0, W, H);
      const box = { x: 50, y: 8, w: W - 62, h: H - 40 };
      const lim = 10;
      const ylab = mode === 0 ? 'random constant $b$ [°/h]' : mode === 1 ? 'random walk bias $b$ [°/h]' : 'Gauss–Markov bias $b$ [°/h]';
      const A = axes(ctx, P, box, [0, T], [-lim, lim], { ylabel: ylab, xlabel: 'time $t$ [min]', xfmt: (v) => `${v}`, yfmt: (v) => v.toFixed(0), zeroLine: true });
      ctx.globalAlpha = 0.35;
      for (let j = 1; j < paths.length; j++) series(ctx, box, t, paths[j], A.sx, A.sy, P.muted, 1);
      ctx.globalAlpha = 1;
      series(ctx, box, t, paths[0], A.sx, A.sy, P.accent, 1.75);
      const m = 240, ts = new Float64Array(m + 1), e = new Float64Array(m + 1), rw = new Float64Array(m + 1);
      const keq = sb * Math.sqrt(2 / tc);
      for (let i = 0; i <= m; i++) { ts[i] = (T * i) / m; e[i] = sigma(ts[i]); rw[i] = keq * Math.sqrt(ts[i]); }
      if (mode === 2) {
        for (const sg of [1, -1]) series(ctx, box, ts, rw.map((v) => sg * v), A.sx, A.sy, P.muted, 1.25, [5, 4]);
        for (const sg of [1, -1]) series(ctx, box, [0, T], [sg * sb, sg * sb], A.sx, A.sy, P.soft, 1, [1, 3]);
        label(ctx, '$\\pm\\sigma_b$', box.x + box.w - 6, A.sy(sb) - 9, P.soft, { size: 11, align: 'right' });
        if (tc < T) {
          const x = A.sx(tc);
          ctx.strokeStyle = P.fg; ctx.lineWidth = 1; ctx.setLineDash([2, 3]);
          ctx.beginPath(); ctx.moveTo(x, box.y); ctx.lineTo(x, box.y + box.h); ctx.stroke(); ctx.setLineDash([]);
          label(ctx, '$t = \\tau_c$', x + 5, box.y + box.h - 12, P.fg, { size: 11 });
        }
      }
      for (const sg of [1, -1]) series(ctx, box, ts, e.map((v) => sg * v), A.sx, A.sy, P.fg, 1.5, [5, 4]);
      let m2 = 0; for (const v of finals) m2 += v * v;
      out('emp', `${Math.sqrt(m2 / RUNS).toFixed(2)} °/h`); out('th', `${sigma(T).toFixed(2)} °/h`);
      out('note', mode === 0 ? 'every run is flat; only the start value is random'
        : mode === 1 ? 'the spread keeps growing like the square root of t'
        : tc > T ? 'correlation time longer than the plot: looks like a random walk'
        : tc < T / 12 ? 'correlation time short: the spread reaches its limit quickly' : 'random walk at first, bounded later');
    }

    const enable = () => {
      inputs.s0.disabled = mode !== 0; inputs.k.disabled = mode !== 1; inputs.sb.disabled = mode !== 2; inputs.tc.disabled = mode !== 2;
      for (const i of Object.values(inputs)) i.closest('label')!.style.opacity = i.disabled ? '0.45' : '1';
    };
    const upd = () => { simulate(); draw(); };
    slider(fig, 's0', (v) => v.toFixed(1), (v) => { s0 = v; upd(); });
    slider(fig, 'k', (v) => v.toFixed(1), (v) => { K = v; upd(); });
    slider(fig, 'sb', (v) => v.toFixed(1), (v) => { sb = v; upd(); });
    slider(fig, 'tc', (v) => { const x = 10 ** v; return x >= 10 ? x.toFixed(0) : x.toFixed(1); }, (v) => { tc = 10 ** v; upd(); });
    const mb = fig.querySelectorAll<HTMLButtonElement>('[data-mode]');
    mb.forEach((b) => b.addEventListener('click', () => { mode = Number(b.dataset.mode); mb.forEach((x) => x.setAttribute('aria-pressed', String(x === b))); enable(); upd(); }));
    fig.querySelector('[data-act="seed"]')!.addEventListener('click', () => { seed++; upd(); });
    enable();
  }
</script>
