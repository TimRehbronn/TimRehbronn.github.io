---
import { SITE } from '../config';
import SocialLinks from './SocialLinks.astro';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container inner">
    <p class="label">© {year} {SITE.name} · {SITE.location} · <a href="/privacy/">Datenschutz / Privacy</a></p>
    <SocialLinks rss compact />
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--border); margin-top: 6rem; }
  .inner { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1rem; padding-top: 1.75rem; padding-bottom: 2.25rem; }
  p { margin: 0; }
  p a { color: var(--muted); text-decoration: none; }
  p a:hover { color: var(--accent); }
</style>
