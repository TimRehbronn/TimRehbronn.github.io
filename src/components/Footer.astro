---
import { SITE, SOCIALS } from '../config';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container inner">
    <p>© {year} {SITE.name}</p>
    <ul class="link-row">
      {SOCIALS.map((s) => <li><a href={s.href}>{s.label}</a></li>)}
      <li><a href="/rss.xml">RSS</a></li>
    </ul>
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--border); margin-top: 5rem; color: var(--muted); font-size: 0.9rem; }
  .inner { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 0.75rem; padding-top: 1.5rem; padding-bottom: 2rem; }
  p { margin: 0; }
</style>
