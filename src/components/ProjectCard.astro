---
import type { CollectionEntry } from 'astro:content';
import { linkEntries } from '../lib/format';
interface Props { project: CollectionEntry<'projects'> }
const { project } = Astro.props;
const p = project.data;
const href = `/projects/${project.id}/`;
const links = linkEntries(p.links);
---

<article class="card">
  {p.image && <a href={href} tabindex="-1" aria-hidden="true"><img src={p.image} alt="" loading="lazy" /></a>}
  <div class="content">
    <div class="top muted small">
      <span>{p.year}</span>
      {p.status !== 'completed' && <span class="status" data-status={p.status}>{p.status}</span>}
    </div>
    <h3><a href={href}>{p.title}</a></h3>
    <p>{p.summary}</p>
    <ul class="tags">{p.tags.map((t) => <li class="tag">{t}</li>)}</ul>
    {links.length > 0 && (
      <ul class="link-row links">
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    )}
  </div>
</article>

<style>
  .card { display: flex; flex-direction: column; border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; background: var(--bg); transition: border-color 0.15s, transform 0.15s; }
  .card:hover { border-color: color-mix(in srgb, var(--accent) 50%, var(--border)); }
  img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; background: var(--bg-soft); border-bottom: 1px solid var(--border); }
  .content { padding: 1rem 1.1rem 1.1rem; display: flex; flex-direction: column; gap: 0.5rem; flex: 1; }
  .top { display: flex; gap: 0.6rem; align-items: center; }
  .status { text-transform: capitalize; font-size: 0.75rem; color: var(--accent); }
  h3 { margin: 0; font-size: 1.05rem; }
  h3 a { color: var(--fg); }
  p { margin: 0; color: var(--fg-soft); font-size: 0.95rem; flex: 1; }
</style>
