---
import 'katex/dist/katex.min.css';
import Base from './Base.astro';
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';

interface Props { post: CollectionEntry<'blog'>; headings: MarkdownHeading[]; minutes: number }
const { post, headings, minutes } = Astro.props;
const { title, description, date, updated, tags } = post.data;
const fmt = new Intl.DateTimeFormat('en', { day: 'numeric', month: 'long', year: 'numeric' });
const toc = headings.filter((h) => h.depth === 2);
---

<Base title={title} description={description} type="article">
  <article class="post">
    <header class="page-header">
      <p class="kicker">
        <time datetime={date.toISOString()}>{fmt.format(date)}</time>
        {updated && <> · updated {fmt.format(updated)}</>} · {minutes} min read
      </p>
      <h1>{title}</h1>
      <p>{description}</p>
      {tags.length > 0 && <ul class="tags" style="margin-top:0.75rem">{tags.map((t) => <li class="tag">{t}</li>)}</ul>}
    </header>

    {
      toc.length > 2 && (
        <nav class="toc" aria-label="Contents">
          <p class="label">Contents</p>
          <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
        </nav>
      )
    }

    <div class="prose prose-width">
      <slot />
    </div>

    <hr />
    <a class="btn" href="/blog/">← All posts</a>
  </article>
</Base>

<style>
  .toc { margin: 0 0 2.5rem; padding: 1rem 1.25rem; border: 1px solid var(--border); background: var(--surface); max-width: var(--w-text); }
  .toc a { text-decoration: none; color: var(--fg-soft); }
  .toc a:hover { color: var(--accent); }
  .toc li::marker { color: var(--accent); font-family: var(--font-mono); font-size: .8em; }
  .toc p { margin: 0 0 0.25rem; }
  .toc ol { margin: 0; padding-left: 1.2rem; font-size: 0.93rem; }
</style>
